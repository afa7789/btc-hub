server {
    listen 80;
    listen [::]:80;
    server_name btc-things.example.com;

    root /var/www/btc-things;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Cache static assets (JS, CSS, images, fonts)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Cache datasets (JSON files)
    location /datasets/ {
        expires 1d;
        add_header Cache-Control "public";
    }

    # Serve files directly
    location / {
        try_files $uri $uri/ =404;
    }

    # Astro builds dist/404.html; without this nginx serves its own bare page.
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # Redirect trailing slashes to non-trailing
    location ~ ^/(.*)/$ {
        return 301 /$1;
    }
}
