---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import NoScriptBanner from "../components/NoScriptBanner.astro";
import Ticker from "../components/Ticker.astro";
import UtilityBar from "../components/UtilityBar.astro";

interface Props {
  title: string;
  description?: string;
  /** True only for pages that compute a default scenario at build time. */
  prerendered?: boolean;
}

const {
  title,
  description = "Unified Bitcoin Tools Platform",
  prerendered = false,
} = Astro.props;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://btc-hub.example.com",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | BTC_THINGS</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | BTC_THINGS`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="BTC_THINGS" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | BTC_THINGS`} />
    <meta property="twitter:description" content={description} />
    
    <link rel="canonical" href={canonicalURL} />

    <!-- Navegacao entre paginas vira troca no cliente: o documento nao recarrega
         e o ticker (transition:persist) mantem animacao e dados. Sem JS o
         componente some do caminho e os links voltam a ser navegacao normal. -->
    <ClientRouter />

    <!-- A unica web font do site. display=swap com fallback monoespacado, para
         o texto nunca ficar invisivel enquanto ela carrega. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pirata+One&display=swap"
    />

    <script is:inline>
      // Applied in <head>, before first paint, so a light-theme visitor never
      // sees a flash of the dark ground. ThemeToggle only handles the click.
      (() => {
        // Escuro e o padrao da identidade; o tema claro so entra por escolha
        // explicita, nao por preferencia do sistema.
        const saved = localStorage.getItem("theme");
        if (saved === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }

        // O router copia os atributos do <html> do documento novo por cima do
        // atual, e o documento novo vem do disco sem data-theme. transition:persist
        // nao se aplica ao <html>, entao o tema e carimbado no documento novo
        // antes da troca — sem piscada e sem reset.
        document.addEventListener("astro:before-swap", (event) => {
          const theme = document.documentElement.getAttribute("data-theme");
          const root = event.newDocument.documentElement;
          if (theme) {
            root.setAttribute("data-theme", theme);
          } else {
            root.removeAttribute("data-theme");
          }
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <NoScriptBanner prerendered={prerendered} />
    <!-- Landmark banner: o ticker e a barra utilitaria ficavam fora de qualquer
         landmark, entao um usuario de leitor de tela navegando por regioes nao
         alcancava o preco nem os controles globais. -->
    <header class="site-header">
      <Ticker />

      <div class="container">
        <UtilityBar>
          <slot name="utility" />
        </UtilityBar>
        <Nav />
      </div>
    </header>
    <div class="container">
      
      <main class="main" id="main" tabindex="-1">
        <slot />
      </main>
      
      <Footer />
    </div>
    
    <style>
      .main {
        flex: 1;
        padding-bottom: 2rem;
      }
    </style>
  </body>
</html>