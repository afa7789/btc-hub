---
/*
 * Rota antiga. A pagina passou a viver em /big-mac — o nome "satsukashii" era o
 * do repositorio que gera o dataset, nunca aparecia na tela, e ninguem
 * conseguia adivinhar a URL a partir de "BIG MAC INDEX".
 *
 * O site e `output: "static"`, entao nao ha servidor para devolver um 301: o
 * redirect tem que estar dentro do HTML. meta refresh faz a navegacao,
 * <link rel="canonical"> passa o sinal para buscadores, e o link visivel e o
 * fallback para quem tem meta refresh bloqueado.
 */
const target = "/big-mac";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>Moved to /big-mac | BTC_THINGS</title>
    <style>
      body {
        margin: 0;
        padding: 2rem;
        background: #000;
        color: #fff;
        font-family: "Courier New", monospace;
        font-size: 13px;
        line-height: 1.6;
      }
      a {
        color: #ff9900;
      }
    </style>
  </head>
  <body>
    <p>[MOVED] /satsukashii is now <a href={target}>/big-mac</a>.</p>
    <p>If you are not redirected, follow the link above.</p>
  </body>
</html>
