---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/base";

const title = "All the Money in the World";
const description =
  "Block visualization comparing global wealth, markets, and assets. Each block = $100 billion USD.";
---

<BaseLayout title={title} description={description}>
  <style>
    /*
     * Escopo: este bloco era `is:global` e redefinia `button`, `input`,
     * `select`, `header` e `h1` para o documento inteiro. Agora e escopado, e o
     * que o JS cria em runtime (sem atributo de escopo do Astro) usa :global().
     *
     * Padronizado com o resto do site (DESIGN.md 4): cabecalho, campos,
     * botoes e grade de numeros vem de global.css; bordas sao
     * --border-width (nao 3px) e texto usa a escala --text-*, nao px solto.
     */

    .atm-scale {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .sample-block {
      flex: none;
      width: 20px;
      height: 20px;
      background: var(--series-neutral);
    }

    .field-actions {
      display: flex;
      gap: 0.75rem;
      align-items: flex-end;
      flex-wrap: wrap;
    }

    /* Botao de alternancia: o estado mora em aria-pressed, nao no texto. */
    .field-actions [aria-pressed="true"] {
      background: var(--accent-btc);
      color: var(--on-accent);
      border-color: var(--accent-btc);
    }

    .control-hint {
      font-size: var(--text-micro);
      color: var(--fg-secondary);
      margin: -0.75em 0 1.5em;
    }

    .hidden {
      display: none !important;
    }

    /*
     * Blocks. Sao <button> desde a task de acessibilidade — o reset abaixo
     * apaga o chrome de botao para o desenho nao mudar.
     */
    :global(.block) {
      -webkit-appearance: none;
      appearance: none;
      margin: 0;
      padding: 0;
      font: inherit;
      color: inherit;
      min-width: 0;
      text-transform: none;
      width: auto;
      height: auto;
      aspect-ratio: 1;
      border: none;
      cursor: pointer;
      position: relative;
      transition: none;
      display: inline-block;
      vertical-align: top;
    }

    :global(.block:focus-visible) {
      z-index: 100;
    }

    /*
     * O tooltip era so :hover, entao teclado e leitor de tela nao alcancavam o
     * unico detalhe disponivel (WCAG 1.4.13).
     */
    :global(.block:hover::after),
    :global(.block:focus-visible::after) {
      content: attr(data-tooltip);
      position: absolute;
      bottom: 25px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--fg-primary);
      color: var(--bg-primary);
      padding: 0.5rem 0.75rem;
      white-space: nowrap;
      z-index: 100;
      font-size: var(--text-micro);
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
      border: var(--border-width) solid var(--border-strong);
    }

    :global(.small-block) {
      opacity: 0.8;
      margin: 0;
      vertical-align: top;
      display: inline-block;
    }

    :global(.small-block:hover) {
      transform: scale(1.2) !important;
    }

    :global(.scale-reference) {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
      padding: 0.75rem 1rem;
      border: var(--border-width) solid var(--chart-grid);
      font-size: var(--text-micro);
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    :global(.scale-blocks-demo) {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    :global(.reference-block) {
      width: 20px;
      height: 20px;
      background: var(--series-neutral);
    }

    .loading {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: var(--bg-surface);
      color: var(--fg-primary);
      padding: 2rem;
      border: var(--border-width) solid var(--border-strong);
      z-index: 1000;
      font-weight: bold;
      text-align: center;
      font-size: var(--text-body);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Aviso de atualizacao: era verde com canto arredondado, em estilo
       inline no script, fora de todo o sistema. */
    :global(.update-notification) {
      position: fixed;
      top: 1.25rem;
      right: 1.25rem;
      background: var(--bg-surface);
      color: var(--fg-primary);
      padding: 0.75rem 1rem;
      border: var(--border-width) solid var(--status-positive);
      font-size: var(--text-micro);
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;
      z-index: 1001;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    :global(.block.updating) {
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    :global(.tooltip) {
      background: var(--bg-primary);
      color: var(--fg-primary);
      border: var(--border-width) solid var(--border-strong);
      border-radius: 0;
      box-shadow: 4px 4px 0 var(--border-strong);
      font-family: var(--font);
      transition: opacity 0.2s ease;
    }

    :global(.tooltip-credibility) {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--border-subtle);
    }

    :global(.credibility-indicator) {
      font-size: var(--text-card);
    }

    :global(.credibility-high) { color: var(--status-positive); }
    :global(.credibility-medium) { color: var(--status-warning); }
    :global(.credibility-low) { color: var(--status-negative); }

    .comparison-mode,
    .data-sources-content {
      margin: 0 0 2em;
      padding: 1rem;
      border: var(--border-width) solid var(--border-strong);
    }

    .comparison-items {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: 1rem;
      margin: 1rem 0;
    }

    :global(.comparison-item) {
      padding: 1rem;
      border: var(--border-width) solid var(--border-subtle);
    }

    :global(.comparison-item h4) {
      color: var(--accent-btc);
      margin-bottom: 0.6rem;
    }

    /*
     * Leitura no estilo do Visual Capitalist, no idioma deste site.
     *
     * - Grade fixa de 40 colunas em todo item: a largura nunca muda, entao a
     *   ALTURA do bloco de quadrados e o que compara um valor com outro.
     *   Antes era flex-wrap, e cada item tinha a sua propria largura.
     * - Quadrados sem borda, separados por espaco: a borda branca de 1px em
     *   25 mil quadrados virava uma malha que brigava com a cor.
     * - Um item por linha, rotulo em texto normal, nota da fonte embaixo.
     */
    /*
     * Canvas escuro fixo nos dois temas, como os outros graficos do site
     * (DESIGN.md 2.2): bitcoin laranja e ouro sobre branco ficariam abaixo de
     * 3:1. Por isso o texto aqui dentro usa --chart-ink, que nao vira.
     */
    .visualization {
      margin-bottom: 2em;
      min-height: 500px;
      padding: 1rem;
      background: var(--chart-bg);
      color: var(--chart-ink);
    }

    #blocks-container {
      display: grid;
      grid-template-columns: repeat(40, minmax(0, 1fr));
      gap: 2px;
      line-height: 0;
    }

    /* No modo agrupado o conteiner tem um filho so, o .blocks-wrapper: ele
       ocupa as 40 colunas em vez de uma. */
    :global(.blocks-wrapper) {
      grid-column: 1 / -1;
      line-height: normal;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    :global(.blocks-container) {
      display: grid;
      grid-template-columns: repeat(40, minmax(0, 1fr));
      gap: 2px;
      line-height: 0;
    }

    :global(.block:hover) {
      outline: 2px solid var(--chart-ink);
      outline-offset: 1px;
      z-index: 10;
    }

    :global(.category-head) {
      margin-top: 1.5rem;
    }

    :global(.category-head h2) {
      margin-bottom: 0.4rem;
      color: var(--chart-ink);
      border-bottom-color: var(--chart-grid);
    }

    :global(.category-note) {
      color: var(--chart-ink-muted);
    }

    :global(.item-label) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    :global(.item-tag) {
      flex-basis: 100%;
      font-size: var(--text-micro);
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--chart-ink-muted);
    }

    :global(.item-name) {
      font-weight: bold;
      color: var(--chart-ink);
    }

    /* Branco, nao laranja: no grid o laranja agora quer dizer bitcoin. */
    :global(.item-value) {
      color: var(--chart-ink);
      font-variant-numeric: tabular-nums;
    }

    :global(.item-note) {
      flex-basis: 100%;
      overflow-wrap: anywhere;
      font-size: var(--text-micro);
      color: var(--chart-ink-muted);
    }

    /* margin: auto devolve a centralizacao do <dialog>, que o reset global
       (* { margin: 0 }) tira e deixava o painel colado no canto. */
    .details-dialog {
      margin: auto;
      width: min(40rem, calc(100vw - 2rem));
      padding: 1.25rem;
      background: var(--bg-surface);
      color: var(--fg-primary);
      border: var(--border-width) solid var(--border-strong);
    }

    .details-dialog::backdrop {
      background: rgb(0 0 0 / 0.75);
    }

    .details-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
    }

    .details-head h2 {
      margin: 0;
      border: none;
      padding: 0;
    }

    .details-value {
      margin: 0.5rem 0 1rem;
      font-size: 1.6em;
      font-weight: bold;
      font-variant-numeric: tabular-nums;
    }

    .details-method {
      margin-bottom: 1rem;
    }

    .details-method summary {
      cursor: pointer;
      font-size: var(--text-micro);
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--fg-secondary);
    }

    .details-method p {
      margin-top: 0.5rem;
      font-size: var(--text-micro);
      color: var(--fg-muted);
      overflow-wrap: anywhere;
    }

    #toggleDataSources {
      margin-bottom: 1rem;
    }
  </style>

  <article>
    <header class="page-header">
      <h1>All the Money in the World</h1>
      <p class="atm-scale">
        <span class="sample-block" aria-hidden="true"></span>
        <span id="atm-summary">Each block = $100 billion USD</span>
      </p>
    </header>
    <p class="source-link"><a href="https://github.com/afa7789/all_the_money_in_the_world" target="_blank" rel="noopener">View the All The Money In The World source on GitHub</a></p>

    <div id="loading" class="loading hidden">Fetching latest data...</div>

    <form class="fields" role="search" onsubmit="return false">
      <div class="field">
        <label for="searchInput">Search items</label>
        <input type="search" id="searchInput" placeholder="gold, bitcoin, silver" aria-describedby="search-hint" />
      </div>
      <div class="field">
        <label for="sortBy">Sort</label>
        <select id="sortBy">
          <option value="category" selected>By category</option>
          <option value="value-desc">By size, largest first</option>
          <option value="value">By size, smallest first</option>
          <option value="name">By name</option>
        </select>
      </div>
      <div class="field-actions">
        <button type="button" id="toggleWrapped" class="btn-secondary" aria-pressed="true">Wrapped</button>
        <button type="button" id="exportData" class="btn-secondary">Export</button>
      </div>
    </form>
    <p id="search-hint" class="control-hint">Separate several items with commas to see them together. To compare them in a table, Ctrl/Cmd-click a block, press Ctrl+Enter on it, or use "Add to comparison" in its details.</p>

    <div id="visualization" class="visualization">
      <div id="blocks-container" class="blocks-container"></div>
    </div>

    <div id="comparison-mode" class="comparison-mode hidden">
      <h2>Compare Items</h2>
      <div id="comparison-items" class="comparison-items"></div>
      <button type="button" id="clearComparison" class="btn-secondary">Clear comparison</button>
    </div>

    <dialog id="item-details" class="details-dialog" aria-labelledby="item-details-title">
      <div class="details-head">
        <h2 id="item-details-title" class="details-title"></h2>
        <button type="button" class="btn-secondary" data-close>Close</button>
      </div>
      <p class="details-value"></p>
      <dl class="stat-grid details-facts"></dl>
      <p class="details-note"></p>
      <details class="details-method">
        <summary>How this number was built</summary>
        <p></p>
      </details>
      <p class="source-link"><a class="details-source" href="" target="_blank" rel="noopener"></a></p>
      <button type="button" class="btn-primary details-compare">Add to comparison</button>
    </dialog>

    <section id="statistics" class="section">
      <h2>Quick Stats</h2>
      <dl class="stat-grid">
        <div><dt>Total value</dt><dd id="totalValue">-</dd></div>
        <div><dt>Total items</dt><dd id="totalItems">-</dd></div>
        <div><dt>Live APIs</dt><dd id="liveItems">-</dd></div>
        <div><dt>Total blocks</dt><dd id="statsBlocks">-</dd></div>
      </dl>
    </section>

    <div id="details" class="details">
      <button type="button" id="toggleDataSources" class="btn-secondary" aria-expanded="false" aria-controls="data-sources">Data sources</button>
      <div id="data-sources" class="data-sources-content hidden"></div>
    </div>

    <p class="source-link">
      <a href="https://www.visualcapitalist.com/all-of-the-worlds-money-and-markets-in-one-visualization-2022/" target="_blank" rel="noopener">See also: Visual Capitalist, All of the World’s Money and Markets in One Visualization (2022)</a>
    </p>
  </article>

  <script is:inline src={withBase("/scripts/all-the-money/script.js")}></script>
</BaseLayout>