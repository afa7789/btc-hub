---
import { tools } from "../data/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/base";

/*
 * Deliberadamente fora de `tools`: aquele grid promete "clique e abre uma
 * pagina deste site". Estes sao repositorios externos, entao ficam numa secao
 * propria, com o destino escrito no rotulo.
 */
// Gerado no build. FIGlet "fraktur" e blackletter desenhado em ASCII — a
// tradicao de banner de terminal. So cabe em string curta, entao vive aqui e
// nao nos titulos das paginas.

const repos = [
  {
    href: "https://github.com/afa7789/mnmncs",
    title: "MNMNCS",
    description:
      "BIP-39 in C — generates entropy and mnemonics, derives the seed with PBKDF2 and keys with BIP-32, and exports xprv and WIF for Electrum and Bitcoin Core.",
    lang: "C",
  },
  {
    href: "https://github.com/afa7789/btc_descriptors_parser",
    title: "BTC_DESCRIPTORS_PARSER",
    description:
      "Bitcoin output descriptor parser and address generator in C — derives keys along BIP-32/44 paths and emits addresses across the common formats. Built on OpenSSL and json-c.",
    lang: "C",
  },
];
---

<BaseLayout title="HOME">
  <div class="landing">
    <header class="landing__header">
      <!-- O wordmark ASCII vive no logo do nav, presente em todas as paginas.
           Repeti-lo aqui seria dizer a mesma coisa duas vezes na mesma tela. -->
      <h1 class="sr-only">BTC_THINGS</h1>
      <p class="landing__subtitle">
        Tools for visualizing Bitcoin, money, and purchasing power over time
      </p>
    </header>

    <section class="tools">
      <h2 class="tools__title">Tools</h2>
      <div class="tools__grid">
        {tools.map(tool => (
          <a href={withBase(tool.href)} class="tool-card">
            <div class="tool-card__header">
              <h3 class="tool-card__title">{tool.label}</h3>
              <span class="tool-card__status">{tool.status}</span>
            </div>
            <p class="tool-card__description">{tool.description}</p>
            <div class="tool-card__footer">
              <span class="tool-card__arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="repos">
      <h2 class="repos__title">Source</h2>
      <ul class="repos__list">
        {repos.map(repo => (
          <li class="repo">
            <a href={repo.href} target="_blank" rel="noopener">
              {repo.title} on GitHub
              <span class="repo__external" aria-hidden="true"> ↗</span>
            </a>
            <span class="repo__lang">[{repo.lang}]</span>
            <p class="repo__description">{repo.description}</p>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>

<style>
  .repos {
    margin-top: 4rem;
  }
  
  .repos__title {
    font-size: var(--text-section);
    text-align: center;
    max-width: 900px;
    margin: 0 auto 2rem;
  }
  
  .repos__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .repo {
    border: var(--border-width) solid var(--border-strong);
    padding: 1.5rem;
  }
  
  /* WCAG 2.5.8: o link nasceu com 17px de altura. */
  .repo a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  
  .repo__lang {
    margin-left: 0.5rem;
    font-size: var(--text-micro);
    letter-spacing: 1px;
    color: var(--fg-muted);
  }
  
  .repo__description {
    margin-top: 0.75rem;
    color: var(--fg-secondary);
  }
  
  .landing {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  .landing__header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .landing__title {
    font-size: 3rem;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    color: var(--accent);
  }
  
  .landing__subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .tools {
    margin-bottom: 4rem;
  }
  
  .tools__title {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }
  
  .tools__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .tool-card {
    border: var(--border-width) solid var(--border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, background-color 0.2s;
    text-decoration: none;
  }
  
  .tool-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  
  .tool-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  
  .tool-card__title {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    padding: 0;
    border: none;
  }
  
  .tool-card__status {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .tool-card__description {
    font-size: 0.9rem;
    /* Herdava --accent-btc do <a>; opacity .8 compunha para #b97f33 = 3.41:1. */
    color: var(--fg-secondary);
    flex-grow: 1;
    margin-bottom: 1rem;
  }
  
  .tool-card__footer {
    display: flex;
    justify-content: flex-end;
  }
  
  .tool-card__arrow {
    font-size: 1.2rem;
    color: var(--accent);
  }
  
  @media (max-width: 768px) {
    .landing__title {
      font-size: 2rem;
    }
    
    .tools__grid {
      grid-template-columns: 1fr;
    }
  }
</style>