---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";

const tools = [
  {
    href: "/sem-melhores",
    title: "SEM MELHORES",
    description: "Top 100 cryptocurrency browser powered by CoinGecko API",
    status: "LIVE",
  },
  {
    href: "/all-the-money",
    title: "ALL THE MONEY IN THE WORLD",
    description:
      "Global wealth block visualization - see all the money in the world",
    status: "LIVE",
  },
  {
    href: "/dca",
    title: "DCA CALCULATOR",
    description:
      "Dollar Cost Averaging calculator with Bitcoin historical data",
    status: "LIVE",
  },
  {
    href: "/debase",
    title: "DEBASE",
    description: "Inflation-adjusted asset charts with D3.js visualizations",
    status: "LIVE",
  },
  {
    href: "/satsukashii",
    title: "BIG MAC INDEX",
    description: "Big Mac Index vs Bitcoin price history comparison",
    status: "LIVE",
  },
  {
    href: "/how-much-i-fucked-up",
    title: "HOW MUCH I FUCKED UP",
    description:
      '"What if I invested X on date Y?" calculator with historical data',
    status: "LIVE",
  },
];
---

<BaseLayout title="HOME">
  <Ticker />
  <div class="landing">
    <header class="landing__header">
      <p class="landing__subtitle">
        Tools for visualizing Bitcoin, money, and purchasing power over time
      </p>
    </header>

    <section class="tools">
      <h2 class="tools__title">TOOLS</h2>
      <div class="tools__grid">
        {tools.map(tool => (
          <a href={tool.href} class="tool-card">
            <div class="tool-card__header">
              <h3 class="tool-card__title">{tool.title}</h3>
              <span class="tool-card__status">{tool.status}</span>
            </div>
            <p class="tool-card__description">{tool.description}</p>
            <div class="tool-card__footer">
              <span class="tool-card__arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .landing {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  .landing__header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .landing__title {
    font-size: 3rem;
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    color: var(--accent);
  }
  
  .landing__subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .tools {
    margin-bottom: 4rem;
  }
  
  .tools__title {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }
  
  .tools__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .tool-card {
    border: var(--border-width) solid var(--border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
    text-decoration: none;
  }
  
  .tool-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  
  .tool-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  
  .tool-card__title {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    padding: 0;
    border: none;
  }
  
  .tool-card__status {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .tool-card__description {
    font-size: 0.9rem;
    opacity: 0.8;
    flex-grow: 1;
    margin-bottom: 1rem;
  }
  
  .tool-card__footer {
    display: flex;
    justify-content: flex-end;
  }
  
  .tool-card__arrow {
    font-size: 1.2rem;
    color: var(--accent);
  }
  
  @media (max-width: 768px) {
    .landing__title {
      font-size: 2rem;
    }
    
    .tools__grid {
      grid-template-columns: 1fr;
    }
  }
</style>