---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Sponsor from "../components/Sponsor.astro";
import { type ToolGroup, tools } from "../data/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/base";
import { btcInGold } from "../utils/btcgold";
import { parseBrl } from "../utils/dolarizacao";
import {
  loadHalvingTimes,
  loadPrices,
  nextHalvingMs,
  usd,
} from "../utils/prerender";
import { BANDS, fitRainbow } from "../utils/rainbow";

/*
 * A home era so um indice: dez cartoes iguais e nenhum numero, num site que
 * existe para mostrar numeros. Agora ela abre com o que o site ja calcula,
 * tudo no build a partir dos datasets do repositorio (sem JS, sem API), e
 * cada numero leva a pagina que o explica. Seis numeros de proposito: fecham
 * em 3x2 ou 2x3, sem cartao sozinho na ultima linha.
 */
const dayFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const d = (iso: string | number) =>
  dayFmt.format(
    typeof iso === "number" ? new Date(iso) : new Date(`${iso}T00:00:00Z`),
  );
const pct = (v: number) =>
  `${v > 0 ? "+" : "−"}${Math.abs(v * 100).toFixed(0)}%`;

const closes = [...loadPrices("bitcoin", "start")]
  .filter(([, price]) => price > 0)
  .sort(([a], [b]) => a.localeCompare(b));
const [lastDate, price] = closes[closes.length - 1] as [string, number];
const [athDate, athPrice] = closes.reduce((m, c) => (c[1] > m[1] ? c : m));

const halvings = loadHalvingTimes();
const lastHalving = halvings[halvings.length - 1] as number;
const nextHalving = nextHalvingMs();
const cycleShare =
  (Date.parse(`${lastDate}T00:00:00Z`) - lastHalving) /
  (nextHalving - lastHalving);

const band = BANDS[fitRainbow().todayBand] as (typeof BANDS)[number];

const gold = btcInGold();
const goldNow = gold[gold.length - 1] as (typeof gold)[number];
const goldAth = gold.reduce((m, p) => (p.oz > m.oz ? p : m));

const brl = parseBrl(
  readFileSync(join(process.cwd(), "public", "datasets", "brl.csv"), "utf8"),
);
const fx = brl[brl.length - 1] as (typeof brl)[number];

interface NowStat {
  label: string;
  value: string;
  note: string;
  href: string;
  link: string;
  swatch?: string;
}

const now: NowStat[] = [
  {
    label: "1 bitcoin",
    value: usd(price, 0),
    note: `${pct(price / athPrice - 1)} from the ${d(athDate)} high`,
    href: "/halving",
    link: "Halving",
  },
  {
    label: "Sats per dollar",
    value: Math.round(1e8 / price).toLocaleString("en-US"),
    note: "What one dollar buys in bitcoin's smallest unit",
    href: "/big-mac",
    link: "Big Mac Index",
  },
  {
    label: "Halving cycle",
    value: `${Math.round(cycleShare * 100)}% through`,
    note: `Next halving around ${d(nextHalving)}`,
    href: "/halving",
    link: "Halving",
  },
  {
    label: "Rainbow band",
    value: band.label,
    swatch: band.color,
    note: "Where the price sits against the power law",
    href: "/rainbow",
    link: "Rainbow",
  },
  {
    label: "In gold",
    value: `${goldNow.oz.toFixed(1)} oz`,
    note: `${pct(goldNow.oz / goldAth.oz - 1)} from the ${d(goldAth.date)} high`,
    href: "/debase#btc-gold-cycles",
    link: "Debase",
  },
  {
    label: "1 dollar in reais",
    value: `R$ ${fx.ptax.toFixed(2).replace(".", ",")}`,
    note: `Central Bank PTAX, ${d(fx.date)}`,
    href: "/dolarizacao",
    link: "Dolarização",
  },
];

/* O indice segue o `group` de routes.ts, na ordem em que um leitor chega:
   graficos, depois ferramentas, depois guias. */
const GROUPS: { id: ToolGroup; title: string }[] = [
  { id: "chart", title: "Charts" },
  { id: "tool", title: "Tools" },
  { id: "guide", title: "Guides" },
];

/*
 * Deliberadamente fora de `tools`: o indice promete "clique e abre uma pagina
 * deste site". Estes sao repositorios externos, entao ficam numa secao
 * propria, com o destino escrito no rotulo.
 */
const repos = [
  {
    href: "https://github.com/afa7789/mnmncs",
    title: "MNMNCS",
    description:
      "BIP-39 in C — generates entropy and mnemonics, derives the seed with PBKDF2 and keys with BIP-32, and exports xprv and WIF for Electrum and Bitcoin Core.",
    lang: "C",
  },
  {
    href: "https://github.com/afa7789/btc_descriptors_parser",
    title: "BTC_DESCRIPTORS_PARSER",
    description:
      "Bitcoin output descriptor parser and address generator in C — derives keys along BIP-32/44 paths and emits addresses across the common formats. Built on OpenSSL and json-c.",
    lang: "C",
  },
  {
    href: "https://github.com/afa7789/wallet-gen",
    title: "WALLET-GEN",
    description:
      "Generates BTC, ETH and XMR wallets from the OS CSPRNG and keeps the private keys under your password (scrypt + AES-256-GCM). App for Mac, Linux and Windows, a CLI, and a web page at afa7789.github.io/wallet-gen.",
    lang: "Python + JS",
  },
];
---

<BaseLayout title="HOME">
  <div class="landing">
    <header class="home-hero">
      <!-- O wordmark ASCII vive no logo do nav, presente em todas as paginas.
           Repeti-lo aqui seria dizer a mesma coisa duas vezes na mesma tela. -->
      <h1 class="sr-only">BTC_THINGS</h1>
      <p class="home-hero__lead">
        Bitcoin against money, measured from data you can check.
      </p>
      <p class="muted">
        Charts, calculators and guides, computed from public datasets that ship
        with the site. No accounts, no tracking.
      </p>
    </header>

    <section class="now" aria-labelledby="now-title">
      <h2 id="now-title">Right now</h2>
      <p class="muted now__meta">Last daily close: {d(lastDate)}.</p>
      <dl class="stat-grid now__grid">
        {now.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>
              {stat.swatch && (
                <span class="swatch" style={`--band: ${stat.swatch}`} aria-hidden="true"></span>
              )}
              {stat.value}
            </dd>
            <dd class="now__note">
              {stat.note}.{" "}
              <a href={withBase(stat.href)}>{stat.link}<span aria-hidden="true"> →</span></a>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    {GROUPS.map((group) => (
      <section class="index" aria-labelledby={`group-${group.id}`}>
        <h2 id={`group-${group.id}`}>{group.title}</h2>
        <ul class="index-list">
          {tools
            .filter((tool) => tool.group === group.id)
            .map((tool) => (
              <li>
                <a href={withBase(tool.href)} class="index-row">
                  <span class="index-row__name">{tool.label}</span>
                  <span class="index-row__desc">{tool.description}</span>
                  <span class="tag">{tool.status}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}

    <section class="repos">
      <h2>Source</h2>
      <ul class="index-list">
        {repos.map((repo) => (
          <li>
            <a href={repo.href} class="index-row index-row--external" target="_blank" rel="noopener">
              <span class="index-row__name">{repo.title}<span class="sr-only"> on GitHub (new tab)</span></span>
              <span class="index-row__desc">{repo.description}</span>
              <span class="tag">{repo.lang}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <Sponsor />
  </div>
</BaseLayout>

<style>
  .home-hero {
    margin: 1rem 0 2.5rem;
  }

  .home-hero__lead {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.35;
    max-width: 32ch;
    margin-bottom: 0.75rem;
  }

  .now {
    margin-bottom: 3rem;
  }

  .now__meta {
    margin-bottom: 1rem;
  }

  /* 16rem, nao os 13rem da grade global: em 920px cabem 3 colunas, e os seis
     numeros fecham 3x2 em vez de 4+2. */
  .now__grid {
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .now__note {
    margin-top: 0.35rem;
    font-size: var(--text-micro);
    font-weight: normal;
    color: var(--fg-muted);
  }

  .now__note a {
    white-space: nowrap;
  }

  .swatch {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-right: 0.4em;
    background: var(--band);
  }

  .index {
    margin-bottom: 2.5rem;
  }

  .index-list {
    list-style: none;
  }

  /*
   * Linha de terminal em vez de cartao: nome, para que serve, de onde vem o
   * dado. Lista nao tem "ultima linha com um cartao sozinho", e o indice de
   * onze paginas cabe numa tela.
   */
  .index-row {
    display: grid;
    grid-template-columns: 15rem 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--fg-primary);
    /* A regra global "li a" sublinha link de prosa; aqui a linha inteira e o
       controle, e sublinhar tres colunas de texto vira ruido. */
    text-decoration: none;
  }

  .index-list li:first-child .index-row {
    border-top: 1px solid var(--border-subtle);
  }

  .index-row:hover {
    background: var(--bg-highlight);
    color: var(--fg-primary);
    text-decoration: none;
  }

  .index-row__name {
    font-weight: bold;
    letter-spacing: 1px;
    color: var(--accent-btc);
  }

  .index-row:hover .index-row__name,
  .index-row:focus-visible .index-row__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .index-row__name::after {
    content: " →";
  }

  .index-row__desc {
    color: var(--fg-secondary);
  }

  @media (max-width: 640px) {
    .index-row {
      grid-template-columns: 1fr auto;
    }

    .index-row__desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .repos {
    margin-top: 1rem;
  }

  /* Repositorio externo: a seta diz "outro site", como o WALLET-GEN do nav. */
  .index-row--external .index-row__name::after {
    content: " ↗";
  }
</style>
