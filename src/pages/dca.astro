---
import { withBase } from "../utils/base";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  computeDca,
  lastDate,
  sampleTransactions,
  usd,
} from "../utils/prerender";

const title = "DCA Calculator";
const description =
  "Dollar Cost Averaging calculator for Bitcoin, Ethereum, Monero, Gold, and Silver";

// The default scenario is computed at build time so the page opens on a real
// result instead of an empty form — and still shows one without JavaScript.
// These values must match the form defaults below and dca.js's clear() reset.
const DEFAULTS = {
  asset: "bitcoin",
  amount: 100,
  frequency: "monthly" as const,
  startDate: "2020-01-01",
  // Runs to the end of the dataset, so "current value" stays current as the
  // CSVs are refreshed instead of freezing on a hardcoded date.
  endDate: lastDate("bitcoin"),
};

const scenario = computeDca(DEFAULTS);
const rows = sampleTransactions(scenario.transactions);
const sampled = rows.length < scenario.transactions.length;

// Mirrors drawChart() in dca.js, but painted in currentColor so it survives a
// theme switch with no script running.
const CHART = { x: 50, y: 50, width: 700, height: 200 };
const points = scenario.transactions;
const maxInvested = Math.max(...points.map((t) => t.totalInvested));
const maxValue = Math.max(...points.map((t) => t.totalUnits * t.price));
const maxY = Math.max(maxInvested, maxValue);
const scaleX = (i: number) =>
  CHART.x + (i / Math.max(points.length - 1, 1)) * CHART.width;
const scaleY = (v: number) =>
  CHART.y + CHART.height - (v / maxY) * CHART.height;
const polyline = (pick: (t: (typeof points)[number]) => number) =>
  points.map((t, i) => `${scaleX(i)},${scaleY(pick(t))}`).join(" ");
const investedLine = polyline((t) => t.totalInvested);
const valueLine = polyline((t) => t.totalUnits * t.price);
const short = (v: number) =>
  v >= 1000 ? `$${(v / 1000).toFixed(0)}k` : `$${v.toFixed(0)}`;
// Nome acessivel do grafico. Sem ele o leitor de tela recebe so os <text>
// soltos do SVG (WCAG 1.1.1). Descreve as duas series, o intervalo e os
// extremos, e aponta a tabela abaixo, que tem os mesmos dados linha a linha.
// dca.js reescreve este mesmo atributo a cada recalculo, senao o rotulo
// congelaria no cenario prerenderizado.
const chartLabel =
  `DCA progress: line chart from ${points[0].date} to ${points[points.length - 1].date}. ` +
  `The dashed line is the total invested, reaching ${short(maxInvested)}; ` +
  `the solid line is the portfolio value, peaking at ${short(maxValue)}. ` +
  `The same data is listed row by row in the transactions table below.`;
---

<BaseLayout title={title} description={description} prerendered>
  <style>
    .disclaimer {
      font-weight: bold;
      color: var(--data-gold);
      margin-bottom: 1em;
    }
    
    .dca-header {
      margin-bottom: 2em;
    }
    
    .dca-header h1 {
      margin: 0;
      border: none;
      padding-bottom: 0;
    }
    
    .input-group {
      margin-bottom: 1em;
    }
    
    .input-group label {
      display: inline-block;
      width: 100px;
    }
    
    .input-group input,
    .input-group select {
      font-family: var(--font);
      border: var(--border-width) solid var(--border);
      padding: 0.5rem;
      background: var(--bg);
      color: var(--fg);
    }
    
    .button-group {
      margin: 1em 0;
    }
    
    #results {
      margin-top: 2em;
    }
    
    #transactions {
      margin-top: 2em;
    }
    
    .result-item {
      margin: 0.5em 0;
    }
    
    .profit-positive {
      color: var(--status-positive);
    }
    
    .profit-negative {
      color: var(--status-negative);
    }
    
    #dca-chart {
      width: 100%;
      max-width: 800px;
      margin: 1em 0;
      border: var(--border-width) solid var(--border);
    }
    
    /* D3 creates these nodes at runtime, so they carry no Astro scope
       attribute — :global() is required or the rules never apply. */
    #dca-chart :global(text) {
      font-family: var(--font);
      font-size: 12px;
      fill: var(--fg);
    }

    #dca-chart :global(line) {
      stroke: var(--border);
    }
    
    /* Com a raiz de volta a 15px no mobile, as 5 colunas monoespacadas passam
       de 390px. Rola dentro do proprio contexto em vez de empurrar a pagina. */
    .table-scroll {
      overflow-x: auto;
    }
    
    table {
      border-collapse: collapse;
      width: 100%;
      margin-top: 1em;
    }
    
    th, td {
      border: var(--border-width) solid var(--border);
      padding: 0.5rem;
      text-align: start;
    }
    
    /* O seletor escopado acima compila para th[data-astro-cid-...] — (0,1,1),
       que vence o .num global em (0,1,0). A regra precisa existir aqui. */
    th.num,
    td.num {
      text-align: right;
    }
    
    @media (max-width: 600px) {
      .input-group {
        display: flex;
        flex-direction: column;
      }
      
      .input-group label {
        width: 100%;
        margin-bottom: 0.25em;
      }
      
      table {
        font-size: 0.85em;
      }
      
      th, td {
        padding: 0.25rem;
      }
    }
  </style>

  <article>
    <header class="dca-header">
      <h1>DCA Calculator</h1>
    </header>

    <p class="disclaimer">
      Disclaimer: This is a demo tool for educational purposes. Data and calculations may not be as accurate as they appear. 
      Always verify with primary sources before making financial decisions.
    </p>

    <section>
      <div class="input-group">
        <label for="asset">Asset:</label>
        <select id="asset">
          <option value="bitcoin" selected>Bitcoin</option>
          <option value="ethereum">Ethereum</option>
          <option value="monero">Monero</option>
          <option value="gold">Gold</option>
          <option value="silver">Silver</option>
        </select>
      </div>

      <div class="input-group">
        <label for="amount">Amount ($):</label>
        <input type="number" id="amount" value="100" min="1">
      </div>
      
      <div class="input-group">
        <label for="frequency">Frequency:</label>
        <select id="frequency">
          <option value="daily">Daily</option>
          <option value="weekly">Weekly</option>
          <option value="monthly" selected>Monthly</option>
        </select>
      </div>
      
      <div class="input-group">
        <label for="start-date">Start:</label>
        <input type="date" id="start-date" value={DEFAULTS.startDate}>
      </div>
      
      <div class="input-group">
        <label for="end-date">End:</label>
        <input type="date" id="end-date" value={DEFAULTS.endDate}>
      </div>
      
      <div class="button-group">
        <button type="button" id="calculate-btn" class="btn-primary">Calculate</button>
        <button type="button" id="clear-btn" class="btn-secondary">Clear</button>
      </div>
    </section>

    <section id="results" role="status">
      <h2>Results</h2>
      <p class="result-item">Total Invested: <span id="total-invested">{usd(scenario.totalInvested)}</span></p>
      <p class="result-item">Asset Acquired: <span id="bitcoin-acquired">{scenario.totalUnits.toFixed(scenario.decimals)} {scenario.symbol}</span></p>
      <p class="result-item">Current Value: <span id="current-value">{usd(scenario.currentValue)}</span></p>
      <p class="result-item">Profit/Loss: <span id="profit-loss" class={scenario.profitLoss >= 0 ? "profit-positive" : "profit-negative"}>{usd(scenario.profitLoss)} ({scenario.profitLoss >= 0 ? "+" : ""}{scenario.profitLossPercent.toFixed(1)}%)</span></p>
      <p class="result-item">Average Price: <span id="average-price">{usd(scenario.averagePrice)}</span></p>
      <p class="result-item">Purchases: <span id="purchase-count">{scenario.transactions.length.toLocaleString("en-US")}</span></p>
    </section>

    <section id="transactions">
      <h2>Transactions</h2>
      
      <svg id="dca-chart" width="800" height="300" viewBox="0 0 800 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label={chartLabel}>
        <text x="10" y="25" font-family="monospace" font-size="15" fill="currentColor">DCA Progress</text>
        <line x1="50" y1="50" x2="50" y2="250" stroke="currentColor" stroke-width="1"/>
        <line x1="50" y1="250" x2="750" y2="250" stroke="currentColor" stroke-width="1"/>
        <text x="10" y="265" font-family="monospace" font-size="11" fill="currentColor">0</text>
        <text x="10" y="155" font-family="monospace" font-size="11" fill="currentColor">{short(maxY / 2)}</text>
        <text x="10" y="65" font-family="monospace" font-size="11" fill="currentColor">{short(maxY)}</text>
        <text x="50" y="280" font-family="monospace" font-size="11" fill="currentColor">Start</text>
        <text x="690" y="280" font-family="monospace" font-size="11" fill="currentColor">End</text>
        <polyline class="chart-line" points={investedLine} stroke="currentColor" stroke-width="2" stroke-dasharray="5,5" fill="none" />
        <polyline class="chart-line" points={valueLine} stroke="currentColor" stroke-width="3" fill="none" />
        <text class="chart-label" x="280" y="30" font-family="monospace" font-size="12" fill="currentColor">--- Total Invested ({short(maxInvested)})</text>
        <text class="chart-label" x="280" y="50" font-family="monospace" font-size="12" fill="currentColor">&#8212; Portfolio Value ({short(maxValue)})</text>
      </svg>
      
      <!-- tabindex: uma regiao rolavel precisa ser alcancavel por teclado. -->
      <div class="table-scroll" tabindex="0" role="region" aria-label="Transactions table">
        <table id="transactions-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Amount</th>
            <th class="num">Price</th>
            <th class="num">Bought</th>
            <th class="num">Total</th>
          </tr>
        </thead>
        <tbody id="transactions-tbody">
          {sampled && (
            <tr>
              <td colspan="5" style="text-align: center; font-style: italic;">
                Showing {rows.length} evenly spaced transactions from {scenario.transactions.length} total
              </td>
            </tr>
          )}
          {rows.map(tx => (
            <tr>
              <td>{tx.date}</td>
              <td class="num">{usd(tx.amount)}</td>
              <td class="num">{usd(tx.price)}</td>
              <td class="num">{tx.unitsBought.toFixed(scenario.decimals)}</td>
              <td class="num">{tx.totalUnits.toFixed(scenario.decimals)}</td>
            </tr>
          ))}
        </table>
      </div>
    </section>
  </article>

  <script is:inline src={withBase("/scripts/dca/dca.js")}></script>
</BaseLayout>
