---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BANDS, bandPrice, fitRainbow } from "../utils/rainbow";

const title = "Rainbow";
const description =
  "Bitcoin's price against a logarithmic regression fitted to our own dataset, with bands at multiples of the residual standard deviation.";

const fit = fitRainbow();

// Desenhado aqui e nao no navegador: e um grafico estatico, entao renderiza
// sem JavaScript — o unico do site que faz isso.
/*
 * Geometria dimensionada PARA O TEXTO, nao ao contrario. O SVG tem viewBox,
 * entao tudo aqui e multiplicado pela escala renderizada (largura na tela /
 * largura do viewBox). No menor viewport a escala e 760/1120 = 0,679, entao
 * um `font-size: 11px` sairia com 7,5px reais — a armadilha do antigo
 * /satsukashii. As fontes (18px nos eixos, 20px nas legendas,
 * declaradas no <style> abaixo) passam de 11px RENDERIZADOS na pior escala, e
 * as margens crescem para caber o texto maior.
 */
const LABEL_FONT = 20;
/** Espacamento minimo entre duas legendas de banda, em unidades do viewBox. */
const LABEL_GAP = LABEL_FONT * 1.25;

const W = 1120;
const H = 540;
const M = { top: 20, right: 330, bottom: 52, left: 96 };
const innerW = W - M.left - M.right;
const innerH = H - M.top - M.bottom;

const lastDay = fit.points[fit.points.length - 1]?.day ?? 1;
const firstDay = fit.points[0]?.day ?? 1;

// Um ponto por semana: 5889 pontos num SVG inline seriam ~200KB de markup.
const sampled = fit.points.filter(
  (_, i) => i % 7 === 0 || i === fit.points.length - 1,
);

/*
 * Limites vindos do preco real, nao da curva ajustada. No dia 1 a regressao
 * vale ~1e-9, entao usar a banda de baixo como piso esticava a escala log por
 * 15 decadas e comprimia o grafico inteiro contra o topo.
 */
const observedMin = Math.min(...fit.points.map((p) => p.price));
const observedMax = Math.max(...fit.points.map((p) => p.price));
const minPrice = observedMin * 0.35;
const maxPrice =
  Math.max(
    observedMax,
    bandPrice(fit, lastDay, BANDS[BANDS.length - 1]?.sigma ?? 2.5),
  ) * 1.4;

const x = (day: number) =>
  M.left + ((day - firstDay) / (lastDay - firstDay)) * innerW;
const y = (price: number) =>
  M.top +
  innerH -
  ((Math.log10(price) - Math.log10(minPrice)) /
    (Math.log10(maxPrice) - Math.log10(minPrice))) *
    innerH;

const bandCurve = (sigma: number) =>
  sampled.map(
    (p) =>
      `${x(p.day).toFixed(1)},${y(bandPrice(fit, p.day, sigma)).toFixed(1)}`,
  );

/*
 * Cada faixa e a area entre a sua curva e a de baixo. A mais baixa fecha numa
 * curva-piso meio sigma abaixo, e nao no fundo do grafico: descer ate o piso
 * pintava metade do painel de azul.
 */
const FLOOR_SIGMA = (BANDS[0]?.sigma ?? -1.5) - 0.5;
const areas = BANDS.map((band, i) => {
  const upper = bandCurve(band.sigma);
  const lower = bandCurve(BANDS[i - 1]?.sigma ?? FLOOR_SIGMA).reverse();
  return { band, points: [...upper, ...lower].join(" ") };
});

const priceLine = sampled
  .map((p) => `${x(p.day).toFixed(1)},${y(p.price).toFixed(1)}`)
  .join(" ");

const priceTicks = [1, 10, 100, 1_000, 10_000, 100_000, 1_000_000].filter(
  (p) => p >= minPrice && p <= maxPrice,
);
const yearTicks = fit.points
  .filter((p) => {
    const d = new Date(
      new Date(`${fit.firstDate}T00:00:00Z`).getTime() +
        (p.day - 1) * 86_400_000,
    );
    return (
      d.getUTCMonth() === 0 &&
      d.getUTCDate() === 1 &&
      d.getUTCFullYear() % 2 === 0
    );
  })
  .map((p) => ({
    day: p.day,
    year: new Date(
      new Date(`${fit.firstDate}T00:00:00Z`).getTime() +
        (p.day - 1) * 86_400_000,
    ).getUTCFullYear(),
  }));

/*
 * O canvas do grafico e escuro nos dois temas (--chart-bg). As cores das
 * bandas foram escolhidas para AREAS, nao para texto: "Basically a fire sale"
 * (#1f4fd8) sobre #0a0a0a mede 2,58:1. A legenda e texto, entao cada cor e
 * clareada em direcao ao branco ate passar 4,5:1 — o matiz continua o mesmo,
 * logo o mapa cor->faixa continua legivel.
 */
const CHART_BG: [number, number, number] = [10, 10, 10];

const channel = (c: number) => {
  const s = c / 255;
  return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
};
const luminance = ([r, g, b]: [number, number, number]) =>
  0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
const contrast = (a: [number, number, number], b: [number, number, number]) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, z) => z - x);
  return ((hi as number) + 0.05) / ((lo as number) + 0.05);
};
const toRgb = (hex: string): [number, number, number] => [
  Number.parseInt(hex.slice(1, 3), 16),
  Number.parseInt(hex.slice(3, 5), 16),
  Number.parseInt(hex.slice(5, 7), 16),
];
const toHex = ([r, g, b]: [number, number, number]) =>
  `#${[r, g, b].map((v) => Math.round(v).toString(16).padStart(2, "0")).join("")}`;

/** Clareia em direcao ao branco ate 4,5:1 sobre o canvas, preservando o matiz. */
function readableOnChart(hex: string): string {
  const base = toRgb(hex);
  for (let step = 0; step <= 20; step++) {
    const t = step / 20;
    const mixed: [number, number, number] = [
      base[0] + (255 - base[0]) * t,
      base[1] + (255 - base[1]) * t,
      base[2] + (255 - base[2]) * t,
    ];
    if (contrast(mixed, CHART_BG) >= 4.5) return toHex(mixed);
  }
  return "#ffffff";
}

/*
 * As nove bandas estao a 0,5 sigma uma da outra: no ultimo dia isso deixa as
 * legendas a ~14 unidades de distancia vertical, menos que a altura de uma
 * linha de 20px. Elas vao para uma coluna de espacamento fixo na margem
 * direita, ligadas a sua banda por uma linha-guia, em vez de empilhadas em
 * cima umas das outras.
 */
const naturalY = BANDS.map((band) => y(bandPrice(fit, lastDay, band.sigma)));
const naturalCentre =
  naturalY.reduce((s, v) => s + v, 0) / Math.max(naturalY.length, 1);
const blockTop = naturalCentre - ((BANDS.length - 1) / 2) * LABEL_GAP;
const clampedTop = Math.min(
  Math.max(blockTop, M.top + LABEL_FONT),
  M.top + innerH - (BANDS.length - 1) * LABEL_GAP,
);
const bandLabels = BANDS.map((band, i) => ({
  band,
  color: readableOnChart(band.color),
  // i cresce de baixo para cima no grafico, entao a coluna e invertida.
  labelY: clampedTop + (BANDS.length - 1 - i) * LABEL_GAP,
  bandY: naturalY[i] ?? 0,
}));

const money = (v: number) =>
  v >= 1000
    ? `$${Math.round(v / 1000).toLocaleString("en-US")}K`
    : `$${Math.round(v)}`;
---

<BaseLayout title={title} description={description}>
  <style>
    .page-header h1 {
      margin: 0;
      border: none;
      padding-bottom: 0;
    }

    .section {
      margin-bottom: 1.5em;
    }

    .rainbow {
      width: 100%;
      max-width: 960px;
      margin: 20px auto;
      background: var(--chart-bg);
      overflow-x: auto;
    }

    /* Regiao rolavel focavel: sem isto ninguem chega ao lado direito do
       grafico so com o teclado (WCAG 2.1.1). */
    .rainbow:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .rainbow svg {
      width: 100%;
      height: auto;
      display: block;
      /* Piso da largura renderizada: com viewBox 1120 isto fixa a pior escala
         em 0,679, e e ela que define os tamanhos de fonte la em cima. */
      min-width: 760px;
      font-family: var(--font);
    }

    /*
     * :not(.band-label) e o ponto todo: qualquer regra CSS vence um atributo
     * de apresentacao, entao um `.rainbow text { fill: ... }` generico pintava
     * as nove legendas de branco e apagava o mapa cor->faixa (WCAG 1.4.1).
     */
    .rainbow text:not(.band-label) {
      fill: var(--chart-ink);
      font-size: 18px;
    }

    .rainbow .band-label {
      font-size: 20px;
      font-weight: bold;
    }

    .verdict {
      font-weight: bold;
      font-size: var(--text-card);
    }

    /*
     * A cor da banda vive num marcador nao textual (criterio 1.4.11, 3:1,
     * garantido pela borda em --fg) e nao no nome da banda: como prosa sobre o
     * fundo da pagina as cores do grafico chegavam a 2,38:1 no tema claro.
     */
    .band-swatch {
      display: inline-block;
      width: 0.8em;
      height: 0.8em;
      margin-right: 0.35em;
      background: var(--band);
      border: 1px solid var(--fg);
      vertical-align: baseline;
    }

    .band-name {
      color: var(--fg);
    }

    .fit-note {
      color: var(--fg-secondary);
    }
  </style>

  <article>
    <header class="page-header">
      <h1>Rainbow</h1>
    </header>

    <section class="section">
      <p>
        Bitcoin's price on a log scale against a logarithmic regression, with
        coloured bands around it. Where the price sits in the bands is the whole
        point of the chart.
      </p>
      <p class="verdict">
        Right now: <span class="band-swatch" style={`--band: ${fit.todayBand.color}`} aria-hidden="true"></span><span class="band-name">{fit.todayBand.label}</span>
        &mdash; {fit.todaySigma.toFixed(2)} standard deviations from the fitted line.
      </p>
    </section>

    <div
      class="rainbow"
      tabindex="0"
      role="region"
      aria-label="Rainbow chart, scrollable"
    >
      <svg
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`Bitcoin price from ${fit.firstDate} to ${fit.lastDate} on a logarithmic scale, against a fitted regression with nine bands. The last close sits ${fit.todaySigma.toFixed(2)} standard deviations from the fit, in the "${fit.todayBand.label}" band.`}
      >
        {areas.map(area => (
          <polygon points={area.points} fill={area.band.color} opacity="0.85" />
        ))}

        {priceTicks.map(price => (
          <g>
            <line
              x1={M.left} x2={M.left + innerW}
              y1={y(price)} y2={y(price)}
              stroke="var(--chart-ink)" stroke-width="0.5" opacity="0.25"
            />
            <text x={M.left - 10} y={y(price) + 6} text-anchor="end">{money(price)}</text>
          </g>
        ))}

        {yearTicks.map(tick => (
          <text x={x(tick.day)} y={M.top + innerH + 28} text-anchor="middle">{tick.year}</text>
        ))}

        <polyline points={priceLine} fill="none" stroke="var(--chart-ink)" stroke-width="1.6" />

        {bandLabels.map(item => (
          <g>
            <line
              x1={M.left + innerW}
              y1={item.bandY}
              x2={M.left + innerW + 10}
              y2={item.labelY - LABEL_FONT * 0.35}
              stroke={item.color}
              stroke-width="1.5"
            />
            <text
              class="band-label"
              x={M.left + innerW + 14}
              y={item.labelY}
              fill={item.color}
            >{item.band.label}</text>
          </g>
        ))}
      </svg>
    </div>

    <section class="section">
      <p class="fit-note">
        The regression is fitted here, at build time, to the same price series
        the rest of the site plots &mdash; not to constants copied from another
        chart. The model is
        <code>log10(price) = {fit.a.toFixed(4)} &middot; ln(days) &minus; {Math.abs(fit.b).toFixed(4)}</code>,
        least squares over {fit.points.length.toLocaleString("en-US")} daily closes
        from {fit.firstDate} to {fit.lastDate}, R&sup2; = {fit.r2.toFixed(3)}.
        The bands sit at multiples of the residual standard deviation
        (&sigma; = {fit.sigma.toFixed(3)} in log10 terms), so their width is a
        property of how far the price has actually strayed from the fit rather
        than a number someone picked.
      </p>
      <p>
        <strong>What it is not:</strong> a forecast. A log regression through a
        rising series will always slope up, and the band you are in says where
        the price is relative to its own past, not where it is going. Refreshing
        the dataset refits the line and moves every band.
      </p>
    </section>
  </article>
</BaseLayout>
