---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/base";
import { closestPrice, loadPrices, usd } from "../utils/prerender";

const title = "Halving";
const description =
  "Bitcoin halvings plotted against the price, with the 500-day window around each one.";

/*
 * A tabela e as tres datas sao conteudo derivado do dataset, entao saem prontas
 * do build — a pagina diz a verdade sem JavaScript, so o grafico depende dele.
 * Mesmo padrao de src/utils/prerender.ts: node:fs no frontmatter.
 */
const HALVINGS_FILE = join(process.cwd(), "public", "datasets", "halvings.txt");

const halvingTimestamps = readFileSync(HALVINGS_FILE, "utf8")
  .split("\n")
  .map((line) => line.trim())
  .filter((line) => line && !Number.isNaN(Number(line)))
  .map(Number);

const BLOCKS_PER_HALVING = 210_000;
const INITIAL_SUBSIDY = 50;
const DAY_MS = 24 * 3600 * 1000;
const WINDOW_DAYS = 500;
/* Media do protocolo: 210.000 blocos a 10 minutos ~ 4 anos julianos. */
const HALVING_INTERVAL_MS = 4 * 365.25 * DAY_MS;

/*
 * Datas do dataset sao meia-noite UTC. Formatar no fuso do servidor de build
 * jogaria cada uma um dia para tras em qualquer offset negativo, entao a
 * formatacao e fixada em UTC.
 */
const longDate = (date: Date): string =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

const pastHalvings = halvingTimestamps.map((timestamp, index) => ({
  number: index + 1,
  height: (index + 1) * BLOCKS_PER_HALVING,
  date: longDate(new Date(timestamp * 1000)),
  subsidy: INITIAL_SUBSIDY / 2 ** (index + 1),
}));

const lastHalving = new Date(
  (halvingTimestamps[halvingTimestamps.length - 1] as number) * 1000,
);
const nextHalving = new Date(lastHalving.getTime() + HALVING_INTERVAL_MS);
const windowOpens = new Date(nextHalving.getTime() - WINDOW_DAYS * DAY_MS);
const windowCloses = new Date(nextHalving.getTime() + WINDOW_DAYS * DAY_MS);

const nextHeight = (halvingTimestamps.length + 1) * BLOCKS_PER_HALVING;
const nextSubsidy = INITIAL_SUBSIDY / 2 ** (halvingTimestamps.length + 1);

const estimates = [
  { label: "Next halving (estimated)", value: longDate(nextHalving) },
  { label: "500-day window opens", value: longDate(windowOpens) },
  { label: "500-day window closes", value: longDate(windowCloses) },
];

/*
 * ---------------------------------------------------------------------------
 * Tese de compra, tese de venda e contra-argumento: todo numero abaixo sai de
 * halvings.txt (as quatro datas) e do CSV de preco, no build. Nada digitado a
 * mao, nada copiado de fora.
 * ---------------------------------------------------------------------------
 */
const priceByDate = loadPrices("bitcoin");
/* Series ordenada por data para varrer intervalos (o Map vem na ordem do CSV,
   que e do mais recente para o mais antigo). */
const priceSeries = [...priceByDate.entries()].sort((a, b) =>
  a[0] < b[0] ? -1 : 1,
);
const lastPriceDate = priceSeries[priceSeries.length - 1]?.[0] as string;
const lastPriceMs = Date.parse(lastPriceDate);

const isoDay = (ms: number): string =>
  new Date(ms).toISOString().slice(0, 10) as string;

const money = (value: number): string =>
  value < 100 ? usd(value, 2) : usd(value, 0);

/* Retorno de um trecho, com sinal explicito. Acima de 100% a casa decimal so
   suja a coluna, entao ela some. */
const pct = (from: number, to: number): string => {
  const value = (to / from - 1) * 100;
  const decimals = Math.abs(value) >= 100 ? 0 : 1;
  const body = Math.abs(value).toLocaleString("en-US", {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  });
  return `${value >= 0 ? "+" : "-"}${body}%`;
};

interface Point {
  date: string;
  price: number;
}

const pointAt = (ms: number): Point => ({
  date: isoDay(ms),
  price: closestPrice(priceByDate, isoDay(ms)) as number,
});

/* Maior fechamento diario dentro de [fromMs, toMs]. Fechamento, nao maxima
   intradiaria: o CSV traz High, mas o resto da pagina fala em Close e misturar
   as duas coisas numa tabela so inventa um topo que ninguem podia ter pego. */
const highestClose = (fromMs: number, toMs: number): Point | null => {
  let best: Point | null = null;
  for (const [date, price] of priceSeries) {
    const ms = Date.parse(date);
    if (ms < fromMs) continue;
    if (ms > toMs) break;
    if (!best || price > best.price) best = { date, price };
  }
  return best;
};

const TWO_YEARS_DAYS = 730;

const cycles = halvingTimestamps.map((timestamp, index) => {
  const halvingMs = timestamp * 1000;
  const opensMs = halvingMs - WINDOW_DAYS * DAY_MS;
  const closesMs = halvingMs + WINDOW_DAYS * DAY_MS;
  const complete = lastPriceMs >= closesMs;

  const opens = pointAt(opensMs);
  const halving = pointAt(halvingMs);
  const peak = highestClose(halvingMs, Math.min(closesMs, lastPriceMs));
  const closes = complete ? pointAt(closesMs) : null;

  /* Onde o ciclo realmente virou: maior fechamento nos dois anos seguintes ao
     halving. Dois anos e um horizonte fixo — usar "ate o proximo halving"
     deixaria a alta que antecede o halving seguinte contaminar o topo do ciclo
     anterior (foi o que aconteceu com 2020: o maximo do intervalo cai em marco
     de 2024, quase quatro anos depois). */
  const horizonMs = halvingMs + TWO_YEARS_DAYS * DAY_MS;
  const horizonComplete = lastPriceMs >= horizonMs;
  const top = highestClose(halvingMs, Math.min(horizonMs, lastPriceMs));
  const trough =
    top === null
      ? null
      : priceSeries.reduce<Point | null>((worst, [date, price]) => {
          const ms = Date.parse(date);
          if (
            ms < Date.parse(top.date) ||
            ms > Math.min(horizonMs, lastPriceMs)
          )
            return worst;
          return !worst || price < worst.price ? { date, price } : worst;
        }, null);

  return {
    number: index + 1,
    year: new Date(halvingMs).getUTCFullYear(),
    complete,
    horizonComplete,
    opens,
    halving,
    peak,
    closes,
    top,
    trough,
    /* Comparacoes ficam aqui: `<=` dentro de uma expressao no template e lido
       como abertura de tag pelo compilador do Astro. */
    topInsideWindow:
      top === null
        ? null
        : Math.round((Date.parse(top.date) - halvingMs) / DAY_MS) <=
          WINDOW_DAYS,
    runUpPositive: halving.price > opens.price,
    daysTopAfterHalving:
      top === null
        ? null
        : Math.round((Date.parse(top.date) - halvingMs) / DAY_MS),
  };
});

/*
 * Peso do corte na emissao, ciclo a ciclo.
 *
 * No halving n ja foram minerados n x 210.000 blocos, entao a oferta existente
 * e 210.000 x 50 x (2 - 2^(1-n)):
 *   n=1 -> 10.500.000    n=2 -> 15.750.000
 *   n=3 -> 18.375.000    n=4 -> 19.687.500
 * A emissao anual e 144 blocos/dia x 365 dias x subsidio = 52.560 x subsidio.
 *
 * 2012: 52.560 x 50  = 2.628.000 BTC/ano sobre 10.500.000 = 25,03% ao ano,
 *       que vira 12,51%. O corte tirou 12,51 pontos percentuais.
 * 2024: 52.560 x 6,25 =  328.500 BTC/ano sobre 19.687.500 =  1,67% ao ano,
 *       que vira 0,83%. O corte tirou 0,83 ponto percentual.
 * Ou seja ~15x menos peso que em 2012 — a ordem de grandeza que o texto cita
 * sai desta conta, calculada aqui, nao de um numero decorado.
 */
const BLOCKS_PER_YEAR = 144 * 365;

const issuance = Array.from(
  { length: halvingTimestamps.length + 1 },
  (_unused, index) => {
    const n = index + 1;
    const subsidyBefore = INITIAL_SUBSIDY / 2 ** (n - 1);
    const supply = BLOCKS_PER_HALVING * INITIAL_SUBSIDY * (2 - 2 ** (1 - n));
    const before = ((BLOCKS_PER_YEAR * subsidyBefore) / supply) * 100;
    return {
      label:
        n <= halvingTimestamps.length
          ? String(
              new Date(
                (halvingTimestamps[index] as number) * 1000,
              ).getUTCFullYear(),
            )
          : "Next",
      subsidyBefore,
      subsidyAfter: subsidyBefore / 2,
      before,
      after: before / 2,
      cut: before / 2,
    };
  },
);

const firstCut = issuance[0];
const latestCut = issuance[halvingTimestamps.length - 1];
const nextCut = issuance[halvingTimestamps.length];

const rate = (value: number): string => `${value.toFixed(2)}%`;

/* Datas da janela por ciclo, para a prosa nao repetir a tabela em texto. */
const completeCycles = cycles.filter((cycle) => cycle.complete);
const topsInsideWindow = cycles.filter(
  (cycle) => cycle.topInsideWindow === true,
).length;
const runUps = cycles.filter((cycle) => cycle.runUpPositive).length;
const measuredTops = cycles.filter((cycle) => cycle.top !== null).length;
/* De quantos dias cada topo passou do fechamento da janela. */
const lateTops = cycles
  .map((cycle) => cycle.daysTopAfterHalving)
  .filter((days): days is number => days !== null && days > WINDOW_DAYS)
  .map((days) => days - WINDOW_DAYS);
---


<BaseLayout title={title} description={description}>
  <style>
    .page-header h1 {
      margin: 0;
      border: none;
      padding-bottom: 0;
    }

    .section {
      margin-bottom: 1em;
    }

    /* Mesma regra do /debase: o canvas fica escuro nos dois temas porque as
       series sao pensadas para fundo preto. Ver DESIGN.md secao 2.2. */
    .brutalist-chart {
      width: 100%;
      max-width: 900px;
      margin: 20px auto;
      display: block;
      overflow: visible;
      box-sizing: border-box;
      /* Horizontal apenas: um container vazio precisa manter clientHeight === 0,
         de que chart_draw.js depende para cair na altura padrao. */
      padding: 0 30px;
      background: var(--chart-bg);
    }

    .next-halving {
      margin: 1em 0;
      font-weight: bold;
      color: var(--status-warning);
    }

    .date-list {
      margin: 0;
    }

    .date-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1ch;
      padding: 0.25em 0;
      border-bottom: var(--border-width) solid var(--border-subtle);
    }

    .date-row dt::after {
      content: ":";
    }

    .date-row dd {
      margin: 0;
      font-variant-numeric: tabular-nums;
    }

    .table-scroll {
      overflow-x: auto;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      margin: 1em 0;
    }

    /* O seletor escopado compila para td[data-astro-cid-...] — (0,1,1), que
       vence o .num global em (0,1,0). A regra precisa existir aqui. */
    th,
    td {
      border: var(--border-width) solid var(--border);
      padding: 0.5rem;
      text-align: start;
    }

    th.num,
    td.num {
      text-align: right;
    }

    .note {
      color: var(--fg-muted);
    }

    /* Data da observacao sob o numero: a coluna continua alinhada a direita e
       tabular, e a data nao disputa peso com o preco. */
    .cell-date {
      display: block;
      color: var(--fg-muted);
      font-size: 0.85em;
      white-space: nowrap;
    }

    article :global(svg) {
      width: 100%;
      height: auto;
      display: block;
      font-family: monospace;
      overflow: visible;
      max-height: 400px;
    }

    article :global(svg text) {
      font-size: 16px;
      font-family: monospace;
      fill: var(--chart-ink);
      font-weight: bold;
      text-transform: uppercase;
    }

    article :global(svg .domain) {
      stroke: var(--chart-ink);
      stroke-width: 3px;
    }

    article :global(svg .tick line) {
      stroke: var(--chart-ink);
      stroke-width: 2px;
    }

    article :global(svg .tick text) {
      fill: var(--chart-ink);
      font-weight: bold;
      font-size: 14px;
    }

    /* Fora do painel escuro: acompanha o tema, ou some no claro. */
    article :global(.legend text) {
      font-family: monospace;
      fill: var(--chart-legend-ink);
    }

    @media (max-width: 600px) {
      article :global(svg text) {
        font-size: 26px;
      }

      article :global(svg .tick text) {
        font-size: 22px;
      }
    }
  </style>

  <article>
    <header class="page-header">
      <h1>Halving</h1>
    </header>

    <section class="section">
      <h2>What a halving is</h2>
      <p>
        Every 210,000 blocks — roughly four years at ten minutes a block — the
        block subsidy paid to miners is cut in half. It started at 50 BTC per
        block in 2009 and is {nextSubsidy.toString()} BTC after the next one.
        Nothing else changes: no vote, no announcement, no discretion. The rule
        is in the code every node runs, so new supply arrives at half the
        previous rate on schedule, and the issuance curve ends at 21 million.
      </p>
      <p>
        The chart plots the price on a log scale with each halving marked, and
        shades the 500 days before and after it.
      </p>
    </section>

    <section class="section">
      <h2>Halvings so far</h2>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Past halvings">
        <table>
          <caption class="sr-only">
            Past Bitcoin halvings: block height, date, and the block subsidy
            each one produced.
          </caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col" class="num">Block</th>
              <th scope="col">Date</th>
              <th scope="col" class="num">Subsidy after</th>
            </tr>
          </thead>
          <tbody>
            {pastHalvings.map((halving) => (
              <tr>
                <td class="num">{halving.number}</td>
                <td class="num">{halving.height.toLocaleString("en-US")}</td>
                <td>{halving.date}</td>
                <td class="num">{halving.subsidy} BTC</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Four halvings. Four data points. Enough to describe what happened, not
        enough to call it a pattern.
      </p>
    </section>

    <section class="section">
      <h2>The next one</h2>
      <div id="next-halving" class="next-halving">
        <dl class="date-list">
          {estimates.map((estimate) => (
            <div class="date-row">
              <dt>{estimate.label}</dt>
              <dd>{estimate.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <p>
        The date is an estimate, not a fixed point on the calendar. What the
        protocol fixes is a block height — {nextHeight.toLocaleString("en-US")}
        — and blocks do not arrive on a clock. Difficulty retargets every 2,016
        blocks to pull the average back toward ten minutes, but hash rate keeps
        growing between retargets, so blocks tend to come in slightly fast and
        the height arrives slightly early. The figures above assume a flat four
        years from the last halving; the real date drifts by weeks.
      </p>
    </section>

    <section class="section">
      <h2>Chart</h2>
      <div id="halving-chart" class="brutalist-chart"></div>
      <noscript>
        <p>
          This chart is drawn in the browser from a price dataset. Enable
          JavaScript to see it. The dates and the table above are rendered at
          build time and do not need it.
        </p>
      </noscript>
      <h2>The 500-day window</h2>
      <p>
        The shaded bands cover the 500 days leading up to each halving and the
        500 days after it — a little under three years around each event. The
        claim people take from it is that buying into the run-up and holding
        through the window has historically worked out. That is a reading of
        four episodes, each with its own macro backdrop, market structure and
        set of leveraged blowups. The supply cut is real and mechanical; the
        price behaviour around it is four observations of a market that was a
        different size every time.
      </p>
    </section>

    <section class="section">
      <h2>The Buy Thesis</h2>
      <p>
        The argument for accumulating in the 500 days before a halving is a
        supply argument. The cut is scheduled, mechanical and public: on a known
        block height the subsidy halves, and the number of new coins reaching
        the market each day halves with it. Nobody has to agree to it. The claim
        is that flow matters — that if demand does not fall at the same instant,
        the same buying meets half the new supply, and the price is what gives.
      </p>
      <p>
        The second half of the claim is that the market does not price the cut
        in advance, even though the date is on everyone's calendar. What people
        point at is the run-up itself: measured from the day the window opened
        to the day of the halving, the price rose in
        {runUps}
        of the {cycles.length} cycles — {cycles
          .map((cycle) => `${cycle.year} ${pct(cycle.opens.price, cycle.halving.price)}`)
          .join(", ")}. That is the whole evidence base, and it is four numbers
        wide.
      </p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Price at each point of the 500-day window">
        <table>
          <caption class="sr-only">
            For each halving: the closing price when the 500-day window opened,
            on the halving itself, at the highest close inside the window, and
            when the window closed — with the return of each leg.
          </caption>
          <thead>
            <tr>
              <th scope="col">Cycle</th>
              <th scope="col" class="num">Window opens</th>
              <th scope="col" class="num">At halving</th>
              <th scope="col" class="num">Highest close in window</th>
              <th scope="col" class="num">Window closes</th>
              <th scope="col" class="num">Open -&gt; halving</th>
              <th scope="col" class="num">Halving -&gt; high</th>
              <th scope="col" class="num">High -&gt; close</th>
            </tr>
          </thead>
          <tbody>
            {cycles.map((cycle) => (
              <tr>
                <th scope="row">{cycle.year}</th>
                <td class="num">
                  {money(cycle.opens.price)}
                  <span class="cell-date">{cycle.opens.date}</span>
                </td>
                <td class="num">
                  {money(cycle.halving.price)}
                  <span class="cell-date">{cycle.halving.date}</span>
                </td>
                <td class="num">
                  {cycle.peak ? money(cycle.peak.price) : "no data"}
                  <span class="cell-date">
                    {cycle.peak
                      ? cycle.complete
                        ? cycle.peak.date
                        : `${cycle.peak.date}, window still open`
                      : "-"}
                  </span>
                </td>
                <td class="num">
                  {cycle.closes ? money(cycle.closes.price) : "no data yet"}
                  <span class="cell-date">
                    {cycle.closes ? cycle.closes.date : `dataset ends ${lastPriceDate}`}
                  </span>
                </td>
                <td class="num">{pct(cycle.opens.price, cycle.halving.price)}</td>
                <td class="num">
                  {cycle.peak ? pct(cycle.halving.price, cycle.peak.price) : "-"}
                </td>
                <td class="num">
                  {cycle.peak && cycle.closes
                    ? pct(cycle.peak.price, cycle.closes.price)
                    : "-"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Daily closes from the same price dataset the chart uses, read at build
        time. Where the window opens or closes on a day the dataset does not
        cover, the nearest available close is used. A cycle whose window has not
        closed yet says so in the row instead of showing a number.
      </p>
    </section>

    <section class="section">
      <h2>The Sell Thesis</h2>
      <p>
        The mirror argument is about getting out. Each cycle has put in a high
        and then given most of it back, so the thesis is to hold through the
        halving and realise somewhere in the 500 days after it, treating the
        close of the window as a deadline rather than a target.
      </p>
      <p>
        The deadline is the part the data does not support. Taking the highest
        daily close in the two years after each halving, the high landed
        {" "}{cycles
          .map((cycle) => `${cycle.year} day ${cycle.daysTopAfterHalving}`)
          .join(", ")} — inside the 500-day window in {topsInsideWindow} of the
        {" "}{measuredTops} cycles. The other {measuredTops - topsInsideWindow}
        {" "}topped after the window had already closed, by
        {" "}{Math.min(...lateTops)} to {Math.max(...lateTops)} days. What did
        hold is the second
        half: every one of those highs was followed by a drawdown of half or
        more within the same two years.
      </p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Where each cycle high landed">
        <table>
          <caption class="sr-only">
            For each halving: the highest daily close in the two years that
            followed, how many days after the halving it came, whether that was
            inside the 500-day window, and the lowest close between that high
            and the end of the two years.
          </caption>
          <thead>
            <tr>
              <th scope="col">Cycle</th>
              <th scope="col" class="num">High within two years</th>
              <th scope="col" class="num">Days after halving</th>
              <th scope="col">Inside the window</th>
              <th scope="col" class="num">Lowest close after it</th>
              <th scope="col" class="num">Drawdown</th>
            </tr>
          </thead>
          <tbody>
            {cycles.map((cycle) => (
              <tr>
                <th scope="row">{cycle.year}</th>
                <td class="num">
                  {cycle.top ? money(cycle.top.price) : "no data"}
                  <span class="cell-date">{cycle.top ? cycle.top.date : "-"}</span>
                </td>
                <td class="num">{cycle.daysTopAfterHalving ?? "-"}</td>
                <td>
                  {cycle.topInsideWindow === null
                    ? "-"
                    : cycle.topInsideWindow
                      ? "yes"
                      : "no"}
                  {cycle.horizonComplete ? "" : " (two years not elapsed)"}
                </td>
                <td class="num">
                  {cycle.trough ? money(cycle.trough.price) : "-"}
                  <span class="cell-date">{cycle.trough ? cycle.trough.date : "-"}</span>
                </td>
                <td class="num">
                  {cycle.top && cycle.trough
                    ? pct(cycle.top.price, cycle.trough.price)
                    : "-"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Two years after the halving is a fixed horizon, chosen so the run-up
        into the next halving cannot be counted as the previous cycle's high.
        Measured to the next halving instead, the 2020 cycle's highest close
        falls in March 2024, four years later.
      </p>
    </section>

    <section class="section">
      <h2>What Argues Against Both</h2>
      <p>
        There are four halvings. Four events is not a sample; it is an anecdote
        with dates. Every one of them happened in a market of a different size,
        under different regulation, with different instruments available and a
        different set of leveraged failures on the way down. Both theses above
        are read off the same four lines.
      </p>
      <p>
        The efficient-market objection is harder to wave off than the sample
        size. The halving is the most telegraphed supply event in any market:
        the block height is fixed in code, the date is estimated years out, and
        every participant can see it. A cut that everyone knows is coming should
        already be in the price. Nothing about the schedule stops that from
        being true.
      </p>
      <p>
        The 2024 halving also landed in a different regime. Spot ETFs began
        trading in January of that year, three months before the halving, which
        changed who was buying and through what. Whatever the previous three
        cycles measured, they measured a market without that.
      </p>
      <p>
        And the cut itself is getting smaller. What the halving removes is a
        share of new supply, and new supply keeps shrinking against the coins
        already in existence. In {firstCut?.label} the subsidy fell from
        {" "}{firstCut?.subsidyBefore} to {firstCut?.subsidyAfter} BTC, which
        took annual issuance from {rate(firstCut?.before ?? 0)} of the coins
        then in existence to {rate(firstCut?.after ?? 0)} — a cut of
        {" "}{rate(firstCut?.cut ?? 0)} of circulating supply per year. In
        {" "}{latestCut?.label} the same halving of the subsidy removed
        {" "}{rate(latestCut?.cut ?? 0)}, about
        {" "}{Math.round((firstCut?.cut ?? 0) / (latestCut?.cut ?? 1))} times
        less. The next one removes {rate(nextCut?.cut ?? 0)}.
      </p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Issuance removed by each halving">
        <table>
          <caption class="sr-only">
            For each halving: the subsidy before and after, annual issuance as a
            share of the coins in existence at that block height before and
            after, and the difference.
          </caption>
          <thead>
            <tr>
              <th scope="col">Halving</th>
              <th scope="col" class="num">Subsidy</th>
              <th scope="col" class="num">New supply/yr before</th>
              <th scope="col" class="num">After</th>
              <th scope="col" class="num">Removed</th>
            </tr>
          </thead>
          <tbody>
            {issuance.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="num">{row.subsidyBefore} -&gt; {row.subsidyAfter} BTC</td>
                <td class="num">{rate(row.before)}</td>
                <td class="num">{rate(row.after)}</td>
                <td class="num">{rate(row.cut)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Issuance is {BLOCKS_PER_YEAR.toLocaleString("en-US")} blocks a year — 144
        a day at ten minutes each — times the subsidy, over the coins already
        mined at that block height. Coins that are lost are still counted; there
        is no way to measure them.
      </p>
      <p>
        None of this says what the window is worth. It says what it is: a
        scheduled, shrinking supply cut, with {cycles.length} price histories
        around it, {measuredTops - topsInsideWindow} of which put their high
        after the window had closed.
      </p>
    </section>
  </article>

  <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/idb@7/build/umd.js"></script>
  <script is:inline src={withBase("/scripts/debase/chart_draw.js")}></script>
  <script is:inline src={withBase("/scripts/debase/dataset_manager.js")}></script>

  <script is:inline>
    /*
     * dataset_manager.js espera estes dois helpers no window; sem eles ele
     * ainda funciona (refaz o fetch do CSV) mas loga erro a cada carga.
     * Duplicados do /debase — a alternativa seria extrair um modulo, o que
     * vale a pena quando existir uma terceira pagina usando o manager.
     */
    window.idbGet = async function (key) {
      try {
        if (typeof window.idb === 'undefined') {
          throw new Error('idb library not loaded');
        }

        const db = await window.idb.openDB('csvDataStore', 1, {
          upgrade(db) {
            db.createObjectStore('datasets');
          }
        });
        const result = await db.get('datasets', key);
        if (result !== undefined) return result;
      } catch (e) {
        console.warn('IndexedDB unavailable, falling back to localStorage:', e);
      }
      const stored = localStorage.getItem(key);
      return stored ? JSON.parse(stored) : null;
    };

    window.idbSet = async function (key, value) {
      try {
        if (typeof window.idb === 'undefined') {
          throw new Error('idb library not loaded');
        }

        const db = await window.idb.openDB('csvDataStore', 1, {
          upgrade(db) {
            db.createObjectStore('datasets');
          }
        });
        await db.put('datasets', value, key);
        return;
      } catch (e) {
        console.warn('IndexedDB unavailable, falling back to localStorage:', e);
      }
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch (err) {
        console.error('Both IndexedDB and localStorage failed:', err);
      }
    };

    async function drawHalvingChart() {
      const container = document.getElementById("halving-chart");
      if (!container) return;

      // Só o BTC: o /debase carrega seis datasets porque precisa do CPI para
      // ajustar por inflação, e nada disso importa aqui.
      await csvManager.initAllDatasets([
        {
          name: "BTC",
          csvPath: window.withBase("/datasets/bitcoin_2010-07-17_2025-07-25.csv"),
          fetchFunction: null,
        },
      ]);

      const halvingTimestamps = await fetch(window.withBase("/datasets/halvings.txt"))
        .then((response) => response.text())
        .then((text) =>
          text
            .split("\n")
            .map((line) => line.trim())
            .filter((line) => line && !Number.isNaN(Number(line)))
            .map(Number),
        );

      const halvings = halvingTimestamps.map((ts) => new Date(ts * 1000));
      const lastHalving = halvings[halvings.length - 1];
      const nextHalving = new Date(
        lastHalving.getTime() + 4 * 365.25 * 24 * 3600 * 1000,
      );
      const windowOpens = new Date(
        nextHalving.getTime() - 500 * 24 * 3600 * 1000,
      );
      const windowCloses = new Date(
        nextHalving.getTime() + 500 * 24 * 3600 * 1000,
      );

      // O frontmatter ja imprimiu estas tres datas no HTML a partir do mesmo
      // dataset e da mesma aritmetica; reescreve-las aqui mantem a pagina
      // correta se o dataset mudar sem um rebuild. Os timestamps sao meia-noite
      // UTC, entao a formatacao e fixada em UTC para nao pular um dia.
      const longDate = (date) =>
        date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
          timeZone: "UTC",
        });

      const dates = [
        ["Next halving (estimated)", nextHalving],
        ["500-day window opens", windowOpens],
        ["500-day window closes", windowCloses],
      ];

      // Reescreve so o texto: elementos criados por JS nao recebem o atributo
      // data-astro-cid do CSS escopado, entao as linhas prerenderizadas ficam.
      const rows = document.querySelectorAll("#next-halving .date-row");
      rows.forEach((row, index) => {
        const entry = dates[index];
        const value = row.querySelector("dd");
        if (entry && value) value.textContent = longDate(entry[1]);
      });

      const btcData = { timestamp: [], price: [] };
      const info = csvManager.getDatasetInfo("BTC");
      csvManager.iterateRange("BTC", info.firstDate, info.lastDate, (date, data) => {
        btcData.timestamp.push(new Date(date));
        btcData.price.push(data.Close);
      });

      chart_drawing.halvingDraw({
        divId: "halving-chart",
        halvingTimestamps,
        nextHalving,
        width: container.clientWidth || 800,
        height: container.clientHeight || 400,
        btcData,
      });
    }

    // ClientRouter: um script ja executado nao roda de novo, entao a ligacao
    // precisa ser em astro:page-load, nao DOMContentLoaded.
    document.addEventListener("astro:page-load", () => {
      if (document.getElementById("halving-chart")) drawHalvingChart();
    });
    if (document.readyState !== "loading" && document.getElementById("halving-chart")) {
      drawHalvingChart();
    }
  </script>
</BaseLayout>
