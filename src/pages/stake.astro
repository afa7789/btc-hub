---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/base";
import { holdingsHtml, parseDays } from "../utils/holdings";
import { holdingSource } from "../utils/prerender";
import {
  CHART_START,
  EDGE_CAP,
  ETH_STAKE_APY,
  SRS_APY,
  breakEven,
  compare,
  edgeBarsSvg,
  growthChartSvg,
  rolling,
  trailing,
  worstDrawdown,
} from "../utils/stake";

const title = "SRS vs ETH Stake";
const description =
  "A fixed 4.5% savings rate against staked ether, simulated on the ether price: since 2023, over trailing windows, and from every starting month.";

/*
 * Tudo abaixo sai do CSV de preco do ether, no build. As duas taxas sao
 * premissas (src/utils/stake.ts); o resto nao e digitado.
 */
const srcs = ["ethereum", "bitcoin", "sp500", "gold", "silver", "monero"].map(
  holdingSource,
);
const loaded = srcs.map((s) => ({
  key: s.key,
  label: s.label,
  note: s.note,
  days: parseDays(s.text, s.kind),
}));
const series = loaded[0]?.days ?? [];
const last = series[series.length - 1];
if (!last) throw new Error("stake: serie de ETH vazia");

const windows = trailing(series);
const sinceStart = windows[windows.length - 1];
const oneYear = rolling(series, 1);
const twoYears = rolling(series, 2);
const drawdown = worstDrawdown(series, CHART_START);

/*
 * Calculador: o cenario padrao sai pronto do build; o script la embaixo so
 * refaz a conta quando o valor ou a data mudam, com os mesmos CSVs.
 */
const CALC = { usd: 1000, from: CHART_START };
const others = loaded.slice(1);
const holdings = compare(CALC.usd, CALC.from, series, others);
const sources = JSON.stringify(
  srcs.map(({ key, kind, label, note, file }) => ({
    key,
    kind,
    label,
    note,
    url: withBase(`/datasets/${file}`),
  })),
);

const wins = (rows: { edge: number }[]) =>
  rows.filter((r) => r.edge > 0).length;
const extreme = (rows: { edge: number }[], pick: (...v: number[]) => number) =>
  pick(...rows.map((r) => r.edge));

const pct = (v: number): string => {
  const abs = Math.abs(v * 100);
  const body = abs.toLocaleString("en-US", {
    maximumFractionDigits: abs >= 100 ? 0 : 1,
  });
  return `${v < 0 ? "−" : "+"}${body}%`;
};
const rate = (v: number): string => `${(v * 100).toFixed(1)}%`;
const dayFmt = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const d = (iso: string) => dayFmt.format(new Date(`${iso}T00:00:00Z`));
const ahead = (l: { srs: number; stake: number }) =>
  l.stake > l.srs ? "ETH stake" : "SRS";
---

<BaseLayout title={title} description={description} prerendered>
  <style>
    .section {
      margin-bottom: 2.5em;
    }

    .chart :global(.grid) {
      stroke: var(--chart-grid);
      stroke-width: 1;
    }

    .chart :global(path) {
      fill: none;
      stroke-width: 2;
    }

    .chart :global(.line-srs) {
      stroke: var(--series-srs);
    }

    .chart :global(.line-stake) {
      stroke: var(--series-eth-stake);
    }

    .key {
      display: inline-block;
      width: 0.8em;
      height: 0.8em;
      margin-right: 0.4em;
      vertical-align: baseline;
    }

    .key-srs {
      background: var(--series-srs);
    }

    .key-stake {
      background: var(--series-eth-stake);
    }
  </style>

  <article>
    <header class="page-header">
      <h1>SRS vs ETH Stake</h1>
      <p>
        A dollar savings rate against staked ether: Sky Protocol MakerDAO
        Savings, called SRS here, simulated at a flat {rate(SRS_APY)} a year,
        and Ethereum staking, simulated at {rate(ETH_STAKE_APY)} a year plus
        whatever the ETH price did. Both measured in dollars.
      </p>
      <p class="muted">
        A simulation on two assumed rates, not a recommendation. It moved here
        from <a href={withBase("/debase")}>/debase</a>. Data through {d(last.date)}.
      </p>
    </header>

    <section class="section">
      <h2>Key findings</h2>
      <ul class="points">
        {sinceStart && (
          <li>
            <strong>Since {d(sinceStart.from)}, {ahead(sinceStart)} is
            ahead:</strong> SRS <mark>{pct(sinceStart.srs)}</mark>, ETH stake
            <mark>{pct(sinceStart.stake)}</mark>.
          </li>
        )}
        <li>
          <strong>Held for one year from the start of any month since
          {" "}{series[0]?.date.slice(0, 4)}, ETH stake beat SRS in
          <mark>{wins(oneYear)} of {oneYear.length}</mark> starts.</strong>
          The gap ran from {pct(extreme(oneYear, Math.min))} to
          {" "}{pct(extreme(oneYear, Math.max))}.
        </li>
        {drawdown && (
          <li>
            <strong>The staked leg fell <mark>{pct(drawdown.depth)}</mark>
            from its high</strong> between {d(drawdown.peak.date)} and
            {" "}{d(drawdown.low.date)}. The simulated SRS leg never falls.
          </li>
        )}
        <li>
          <strong>The break-even is <mark>{rate(breakEven)} a year</mark>:</strong>
          ETH has to appreciate that much for staking to tie SRS on these two
          rates.
        </li>
        <li>
          <strong><mark>Both rates are assumptions</mark>.</strong> Neither is
          fixed in real life; see the open questions below.
        </li>
      </ul>
    </section>

    <section class="section">
      <h2>Since July 2023</h2>
      <div
        id="stake-growth"
        class="chart"
        set:html={growthChartSvg(
          series,
          CHART_START,
          "SRS and staked ETH, each starting at 1.0 in July 2023",
        )}
      />
      <p class="legend">
        <span class="key key-srs"></span>SRS, simulated {rate(SRS_APY)} APY
        &nbsp;&nbsp;
        <span class="key key-stake"></span>ETH stake, simulated
        {" "}{rate(ETH_STAKE_APY)} APY + ETH price. Each line starts at 1.0.
      </p>
    </section>

    <section class="section" id="stake-calc" data-sources={sources}>
      <h2>What the same money would be</h2>
      <p>
        One sum, one day, eight places to put it. Valued on {d(last.date)}.
      </p>
      <form class="fields" onsubmit="return false">
        <div class="field">
          <label for="calc-usd">Amount (USD)</label>
          <input id="calc-usd" type="number" min="1" step="100" value={CALC.usd} />
        </div>
        <div class="field">
          <label for="calc-from">Put in on</label>
          <input id="calc-from" type="date" min={series[0]?.date} max={series[series.length - 2]?.date} value={CALC.from} />
        </div>
      </form>
      <p id="calc-status" class="muted" role="status"></p>
      <div class="table-wrap" tabindex="0" role="region" aria-label="The same money in each place, valued today">
        <table>
          <thead>
            <tr>
              <th scope="col">Where</th>
              <th scope="col">What it tracks</th>
              <th scope="col" class="num">Worth now</th>
              <th scope="col" class="num">Change</th>
            </tr>
          </thead>
          <tbody id="calc-rows" set:html={holdingsHtml(holdings, CALC.usd)} />
        </table>
      </div>
      <p class="legend">
        Sorted from most to least. Prices only: no fees, no tax, no slippage.
        Dates start on {d(series[0]?.date ?? CHART_START)}, the first day of
        the ETH series.
      </p>
    </section>

    <section class="section">
      <h2>Trailing windows</h2>
      <p>The same two legs over windows that end on {d(last.date)}.</p>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Return of each leg over trailing windows">
        <table>
          <thead>
            <tr>
              <th scope="col">Window</th>
              <th scope="col">From</th>
              <th scope="col" class="num">SRS</th>
              <th scope="col" class="num">ETH stake</th>
              <th scope="col" class="num">ETH price alone</th>
              <th scope="col">Ahead</th>
            </tr>
          </thead>
          <tbody>
            {windows.map((w) => (
              <tr>
                <th scope="row">{w.label}</th>
                <td>{d(w.from)}</td>
                <td class="num">{pct(w.srs)}</td>
                <td class="num">{pct(w.stake)}</td>
                <td class="num">{pct(w.eth)}</td>
                <td>{ahead(w)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>From every starting month</h2>
      <p>
        One window says little: the answer depends on the day you start. So
        the same comparison, held for one year, starting on the first day of
        every month in the ETH series.
      </p>
      <div
        id="stake-rolling"
        class="chart"
        set:html={edgeBarsSvg(
          oneYear,
          `ETH stake minus SRS over one year, by starting month: ETH stake ahead in ${wins(oneYear)} of ${oneYear.length}`,
        )}
      />
      <p class="legend">
        One bar per starting month. Above zero, ETH stake ended the year ahead
        of SRS; below, behind. Bars are cut at ±{EDGE_CAP * 100}%: the largest
        gap was {pct(extreme(oneYear, Math.max))}.
      </p>
      <ul class="points">
        <li>
          <strong>One year:</strong> ETH stake ahead in
          <mark>{wins(oneYear)} of {oneYear.length}</mark> starts.
        </li>
        <li>
          <strong>Two years:</strong> ETH stake ahead in
          <mark>{wins(twoYears)} of {twoYears.length}</mark> starts, with the
          gap between {pct(extreme(twoYears, Math.min))} and
          {" "}{pct(extreme(twoYears, Math.max))}.
        </li>
        <li>
          <strong>The early years carry the big bars.</strong> ETH was a far
          smaller asset then, and SRS did not exist: before 2023 the fixed leg
          is the same {rate(SRS_APY)} applied backwards, a yardstick, not a
          history.
        </li>
      </ul>
    </section>

    <section class="section">
      <h2>What each leg is</h2>
      <ul class="points">
        <li>
          <strong>SRS is a <mark>fixed, predictable yield</mark></strong> in
          this simulation. It adds smart contract and protocol risk beyond
          ETH's base layer.
        </li>
        <li>
          <strong>ETH staking is <mark>yield plus ETH price exposure</mark>:</strong>
          it outperforms in bull markets and underperforms in downturns. Native
          staking relies solely on Ethereum network security.
        </li>
        <li>
          <strong>The tradeoff is yield stability vs. asset price upside,</strong>
          plus platform risk.
        </li>
        <li>
          <strong>Tax treatment may differ:</strong> fixed-income yields (SRS)
          are often taxed as interest, while ETH price gains may qualify as
          capital gains, affecting net returns.
        </li>
      </ul>
    </section>

    <section class="section">
      <h2>Staking, outside the simulation</h2>
      <dl class="stat-grid">
        <div>
          <dt>ETH supply staked</dt>
          <dd>36.3%</dd>
        </div>
        <div>
          <dt>Previous record</dt>
          <dd>32.4%</dd>
        </div>
        <div>
          <dt>Staking reward rate, 30 days</dt>
          <dd>2.56%</dd>
        </div>
        <div>
          <dt>ETH staked, 30 days</dt>
          <dd>44.49 million</dd>
        </div>
      </dl>
      <ul class="points">
        <li>
          <strong>A record <mark>36.3% of all ETH</mark> was staked on 14 Nov
          2026,</strong> up from the previous record of 32.4% in June 2026
          (<a href="https://www.kucoin.com/pt/news/flash/ethereum-staking-reaches-record-36-3-of-total-supply" target="_blank" rel="noopener">Token Terminal data, via KuCoin</a>).
        </li>
        <li>
          <strong>The measured reward rate is <mark>2.56%</mark>,</strong> a
          30-day figure read on 26 Nov 2026
          (<a href="https://www.stakingrewards.com/asset/ethereum-2-0/analytics" target="_blank" rel="noopener">Staking Rewards</a>).
          The simulation above uses {rate(ETH_STAKE_APY)}.
        </li>
        <li>
          These four figures are typed in from the sources on the dates named.
          They do not update with the page.
        </li>
      </ul>
    </section>

    <section class="section">
      <h2>Open questions</h2>
      <p class="muted">Not answered on this page yet.</p>
      <ul class="points">
        <li>
          <strong>What does it look like with the <mark>real rate history</mark>?</strong>
          The savings rate is set by governance and has moved; so has the
          staking yield. Both are flat lines here.
        </li>
        <li>
          <strong>What if the <mark>peg</mark> slips?</strong> The fixed leg is
          paid in a dollar stablecoin, and the simulation treats it as a dollar.
        </li>
        <li>
          <strong>Who is ahead <mark>measured in ETH</mark>,</strong> not in
          dollars? A holder who thinks in ETH reads every window the other way.
        </li>
        <li>
          <strong>And against <mark>bitcoin</mark>?</strong> Both legs are
          priced in dollars here, never in sats.
        </li>
        <li>
          <strong>How long does the fixed leg need</strong> to catch up after a
          year in which ETH doubled?
        </li>
      </ul>
    </section>
  </article>

  <script>
    import {
      type Loaded,
      type Source,
      holdingsHtml,
      loadSources,
    } from "../utils/holdings";
    import { compare } from "../utils/stake";

    // O router troca o <body> a cada navegacao: os nos sao novos, entao os
    // ouvintes sao religados em cada astro:page-load, e so nesta pagina.
    document.addEventListener("astro:page-load", async () => {
      const root = document.getElementById("stake-calc");
      if (!root) return;
      const usdEl = document.getElementById("calc-usd") as HTMLInputElement;
      const fromEl = document.getElementById("calc-from") as HTMLInputElement;
      const rows = document.getElementById("calc-rows") as HTMLElement;
      const status = document.getElementById("calc-status") as HTMLElement;
      const sources: Source[] = JSON.parse(root.dataset.sources ?? "[]");

      let all: Loaded[] = [];
      try {
        all = await loadSources(sources);
      } catch {
        status.textContent =
          "Could not load the price files; the table shows the default scenario.";
        return;
      }
      const eth = all.find((l) => l.key === "ethereum")?.days ?? [];
      const others = all.filter((l) => l.key !== "ethereum");

      const update = () => {
        const usd = Number.parseFloat(usdEl.value);
        const result = usd > 0 ? compare(usd, fromEl.value, eth, others) : [];
        // Sem resultado valido a tabela esvazia: deixar o anterior na tela
        // faria ele parecer a resposta para os valores novos.
        status.textContent = result.length
          ? ""
          : "Pick an amount above zero and a date inside the ETH series.";
        rows.innerHTML = result.length ? holdingsHtml(result, usd) : "";
      };
      usdEl.addEventListener("input", update);
      fromEl.addEventListener("input", update);
    });
  </script>
</BaseLayout>
