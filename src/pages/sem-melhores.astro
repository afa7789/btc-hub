---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/sem-melhores.css";
---

<BaseLayout title="SemMelhores">
  <div class="sem-melhores-page">
    <header class="main-header">
      <div class="header-left">
        <h1 class="main-title">
          <a href="https://github.com/afa7789/SemMelhores" target="_blank">
            <span class="title-icon">◆</span>
            <span class="title-text">Sem Melhores</span>
          </a>
        </h1>
        <p class="subtitle">~as 100 melhores~ criptomoedas, desconsiderando stablecoins e staked ativos</p>
      </div>
      <div class="header-right">
        <button id="themeToggle" class="theme-toggle">☀️</button>
        <button id="languageToggle" class="language-toggle">🇺🇸</button>
      </div>
    </header>
    
    <div class="search-container">
      <input type="text" id="searchInput" placeholder="Pesquisar criptomoedas..." />
    </div>
    
    <div id="cryptoList"></div>

    <div id="coinModal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <div id="modalBody">
          <p>Carregando...</p>
        </div>
      </div>
    </div>

    <footer class="main-footer">
      <p>don't trust verify</p>
    </footer>
  </div>
</BaseLayout>

<script src="../scripts/sem-melhores/script.ts"></script>

<style>
  /* Hide global theme toggle when on SemMelhores page to avoid conflict */
  :global(#theme-toggle) {
    display: none !important;
  }
</style>
