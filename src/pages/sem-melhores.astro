---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/sem-melhores.css";
---

<BaseLayout title="SEM MELHORES">
  <button type="button" slot="utility" id="languageToggle" class="language-toggle" aria-label="Switch language">🇺🇸</button>

  <div class="sem-melhores-page">
    <header class="main-header">
      <div class="header-left">
        <h1 class="main-title">
          <a href="https://github.com/afa7789/SemMelhores" target="_blank">
            <span class="title-icon">◆</span>
            <span class="title-text">SEM MELHORES</span>
          </a>
        </h1>
        <p class="subtitle">~as 100 melhores~ criptomoedas, desconsiderando stablecoins e staked ativos</p>
      </div>
    </header>
    
    <div class="search-container">
      <label for="searchInput" class="search-label">Pesquisar criptomoedas</label>
      <input type="search" id="searchInput" placeholder="BTC, ethereum..." />
    </div>
    
    <p id="dataNotice" class="data-notice" role="status" hidden></p>

    <div id="cryptoList">
      <!-- Estado inicial no HTML servido: com a API fora, a pagina mostrava um
           vazio sem explicacao entre a busca e o rodape. renderCryptoList()
           substitui isto assim que a lista chega. -->
      <p class="empty-state" id="cryptoListEmpty">
        Carregando moedas da CoinGecko&hellip; a tabela aparece assim que ela
        responder. Se nada aparecer, a API caiu ou limitou a taxa &mdash;
        recarregue em um minuto.
      </p>
    </div>

    <div
      id="coinModal"
      class="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="coinModalTitle"
      hidden
    >
      <div class="modal-content">
        <button type="button" class="close" aria-label="Fechar">&times;</button>
        <div id="modalBody">
          <p id="coinModalTitle">Carregando...</p>
        </div>
      </div>
    </div>

    <!-- Nao e <footer>: o layout ja monta um, e dois landmarks de rodape na
         mesma tela fazem quem navega por regioes parar na banda errada. -->
    <p class="page-tagline">don't trust, verify</p>
  </div>
</BaseLayout>

<script src="../scripts/sem-melhores/script.ts"></script>

<style>
  .page-tagline {
    margin-top: 2rem;
    text-align: center;
    letter-spacing: 0.1em;
    color: var(--fg-secondary);
  }
  
  .empty-state {
    padding: 2rem 0;
    color: var(--fg-secondary);
    max-width: 60ch;
  }
  
  .search-label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: var(--text-micro);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fg-secondary);
  }
  
  /* O modal passa a ser controlado pelo atributo hidden, coerente com
     aria-modal: sem isso o display:none da folha de estilo da pagina venceria. */
  #coinModal[hidden] {
    display: none;
  }

  #coinModal:not([hidden]) {
    display: block;
  }

  /* O <span> virou <button>: neutraliza o estilo global de button e mantem
     a area de toque minima do controle de fechar. */
  #coinModal .close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: none;
    line-height: 1;
    text-transform: none;
  }

  #coinModal .close:hover {
    background: none;
    color: var(--accent);
  }

  /* Matches the theme control it sits beside in the utility bar. */
  .language-toggle {
    /* 26x21 antes: abaixo do minimo de toque. */
    min-height: 44px;
    min-width: 44px;
    padding: 0.25rem 0.6rem;
    font-size: var(--text-micro);
    background: var(--bg-surface);
    border: 1px solid var(--fg-muted);
  }
</style>
