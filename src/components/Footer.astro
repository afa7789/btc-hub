---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__content">
      <p class="footer__copyright">
        © {currentYear} BTC_THINGS — All tools are open source and free to use
      </p>
      <div class="footer__links">
        <a href="/" class="footer__link">HOME</a>
        <span class="footer__separator">|</span>
        <a href="https://github.com" class="footer__link" target="_blank" rel="noopener">
          GITHUB
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-width) solid var(--border);
    padding: 2rem 0;
    margin-top: auto;
    background: var(--bg);
  }
  
  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  
  .footer__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .footer__copyright {
    font-size: 0.9rem;
    opacity: 0.8;
  }
  
  .footer__links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  
  .footer__link {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .footer__separator {
    opacity: 0.5;
  }
  
  @media (max-width: 480px) {
    .footer__content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>