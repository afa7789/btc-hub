---
import wordmark from "../assets/wordmark.txt?raw";
import { siblings, tools } from "../data/routes";
import { stripBase, withBase } from "../utils/base";

// Built pages are served as /dca/, so the raw pathname never matched the
// hrefs below and the active state was dead. Compare without trailing slashes.
//
// E o site vai para GitHub Pages sob "/btc-hub", entao o pathname real e
// "/btc-hub/dca/": stripBase tira o prefixo antes da comparacao, senao o
// estado ativo morre de novo em producao e so em producao.
const current = stripBase(Astro.url.pathname);

/*
 * Gerado por scripts/render-ascii-banner.mjs rasterizando a propria fonte
 * gotica. A largura e fixa em colunas, entao o corpo do caractere sai da
 * largura da caixa: em ~440px sao ~7.4px por caractere.
 */
const wordmarkLines = wordmark.replace(/\n+$/, "").split("\n");
const wordmarkColumns = Math.max(
  ...wordmarkLines.map((line: string) => line.length),
);

/*
 * O agrupamento vem do campo `group` em src/data/routes.ts: qual linha um item
 * ocupa e conhecimento de rota, e duplicar conhecimento de rota foi o que fez
 * nav, home e 404 divergirem antes de routes.ts existir.
 */
const toolRow = tools.filter((item) => item.group === "tool");
const lowerRow = tools.filter((item) => item.group !== "tool");
/*
 * Duas linhas, sempre: ferramentas em cima (com os sites irmaos), graficos e
 * guias embaixo. Um grupo novo NAO ganha linha propria — uma terceira linha
 * com um item sozinho foi rejeitada explicitamente pelo dono do site.
 *
 * Os guias moraram na linha de cima ate o /dolarizacao. Com ele a linha de
 * cima passava da largura maxima do container (1136px uteis) em QUALQUER
 * viewport, entao nenhum breakpoint resolvia: o container trava em 1200px.
 * Mover os guias para a linha de baixo, que era a mais curta, manteve as duas
 * linhas e o limite de duas. Medido, ver o comentario do .nav__links.
 */
const navRows = [toolRow, lowerRow].filter((row) => row.length > 0);
---

<nav class="nav">
  <div class="nav__container">
    <a href={withBase("/")} class="nav__logo" style={`--wordmark-cols: ${wordmarkColumns}`}>
      <span class="sr-only">BTC_THINGS</span>
      <pre class="nav__logo-art" aria-hidden="true">{wordmarkLines.join("\n")}</pre>
      <span class="nav__logo-text" aria-hidden="true">BTC_THINGS</span>
    </a>
    
    <input
      type="checkbox"
      id="nav-open"
      class="nav__toggle-input"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    />
    <div class="nav__links" id="nav-links">
      {navRows.map((row, index) => (
        <div class="nav__row">
          {row.map(item => (
            <a
              href={withBase(item.href)}
              class:list={['nav__link', { 'nav__link--active': current === item.href }]}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          {index === 0 && siblings.map(site => (
            <a href={site.href} class="nav__link" target="_blank" rel="noopener">
              {site.label}<span aria-hidden="true"> ↗</span><span class="sr-only"> (other site, new tab)</span>
            </a>
          ))}
        </div>
      ))}
    </div>
    
    <!-- Rotulo de checkbox, nao botao: sem JS o menu ainda abre, e sem ele o
         nav mobile ficava inalcancavel nas 8 paginas. -->
    <label for="nav-open" class="nav__mobile-toggle">
      <span aria-hidden="true">☰</span>
      <span class="nav__mobile-toggle-text">Menu</span>
    </label>
  </div>
</nav>

<style>
  .nav {
    border-bottom: var(--border-width) solid var(--border);
    padding: 1rem 0;
    margin-bottom: 2rem;
  }
  
  .nav__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .nav__logo {
    display: block;
    container-type: inline-size;
    width: 100%;
    max-width: 520px;
    color: var(--accent);
    line-height: 1;
  }
  
  .nav__logo-art {
    font-family: var(--font);
    font-size: calc(100cqi / (var(--wordmark-cols) * 0.62));
    line-height: 1.02;
    white-space: pre;
    overflow: hidden;
  }
  
  /* Abaixo da largura em que o caractere ainda se ve, o logo volta a ser
     texto na fonte de display. */
  .nav__logo-text {
    display: none;
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.02em;
  }
  
  @media (max-width: 768px) {
    .nav__logo-art {
      display: none;
    }
  
    .nav__logo-text {
      display: block;
    }
  }
  
  /*
   * Duas linhas declaradas, nao `flex-wrap` numa lista unica.
   *
   * Com uma lista so, a quebra e gulosa: a primeira linha engole tudo que
   * couber e sobra o resto — com estes rotulos (de "DEBASE", 6 caracteres, a
   * "ALL THE MONEY IN THE WORLD", 26) dava SETE em cima e UM sozinho embaixo,
   * que le como bug. Aqui cada grupo e a sua propria linha, entao o corte e
   * sempre 4/4 e nunca depende da largura.
   *
   * Cada linha e `nowrap` na pratica. A de cima (ferramentas + WALLET-GEN,
   * site irmao) e a mais larga: com a decoracao "> <" do item ativo os rotulos
   * somam ~911px, mais 6 gaps — MEDIDO no Playwright, nao estimado. O gap
   * cresce com 1.1vw, entao o teto dele e de 1rem: sem teto a linha crescia
   * mais rapido que o container, que trava em 1200px (1136px uteis), e
   * quebrava justo na tela larga. Com o teto a linha precisa de 982px em
   * 1080 (cabe em 1012) e de 1007px no maximo; o menu colapsa abaixo de
   * 1080px (ver o media query do fim). Se uma linha nao couber mais, mexa no
   * breakpoint; se nem a 1136px ela couber, troque um grupo de linha, nunca
   * crie a terceira.
   * O `wrap` fica so como valvula: numa fonte de fallback mais larga o nav
   * quebra em vez de vazar na horizontal.
   */
  .nav__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }
  
  .nav__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.25rem clamp(0.5rem, 1.1vw, 1rem);
  }

  .nav__link {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }
  
  .nav__link {
    color: var(--fg-secondary);
  }
  
  .nav__link:hover {
    text-decoration: none;
    color: var(--accent-btc);
    border-bottom-color: var(--accent-btc);
  }
  
  /* Active page reads as a terminal prompt, so it stays distinct from hover. */
  .nav__link--active {
    color: var(--accent-btc);
    font-weight: bold;
    border-bottom-color: var(--accent-btc);
  }
  
  .nav__link--active::before {
    content: "> ";
  }
  
  .nav__link--active::after {
    content: " <";
  }

  .nav__toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  /* Tratado como controle, nao como glifo decorativo: era o unico caminho
     para o nav no mobile e nao tinha moldura nenhuma. */
  .nav__mobile-toggle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-body);
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    background: var(--bg-surface);
    border: 1px solid var(--fg-muted);
    color: var(--accent-btc);
    cursor: pointer;
    min-height: 44px;
  }
  
  .nav__toggle-input:focus-visible + .nav__links + .nav__mobile-toggle,
  .nav__toggle-input:focus-visible ~ .nav__mobile-toggle {
    outline: var(--border-width) solid var(--border-accent);
    outline-offset: 2px;
  }
  
  /* O disclosure sem JS continua igual: o nav__links some e so o :checked o
     traz de volta — sem script nenhum no caminho. 1079px: a linha de cima
     precisa de 982px em 1080 (comentario do .nav__links); o logo segue em
     768px. */
  @media (max-width: 1079px) {
    .nav__links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.5rem;
    }
    
    /* No mobile os dois grupos viram uma pilha unica: a distincao grafico /
       calculadora nao paga uma linha a mais numa lista vertical. */
    .nav__row {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .nav__toggle-input:checked ~ .nav__links {
      display: flex;
    }
    
    .nav__mobile-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  // O abrir/fechar e CSS puro; o script so mantem aria-expanded em dia.
  // Delegado porque o router troca o <body> e o checkbox vira um no novo a
  // cada navegacao — este script roda uma unica vez por sessao.
  document.addEventListener('change', (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || input.id !== 'nav-open') return;
    input.setAttribute('aria-expanded', String(input.checked));
  });
</script>