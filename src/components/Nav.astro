---
// Built pages are served as /dca/, so the raw pathname never matched the
// hrefs below and the active state was dead. Compare without trailing slashes.
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { href: "/sem-melhores", label: "SEM MELHORES" },
  { href: "/all-the-money", label: "ALL THE MONEY IN THE WORLD" },
  { href: "/dca", label: "DCA CALCULATOR" },
  { href: "/debase", label: "DEBASE" },
  { href: "/satsukashii", label: "BIG MAC INDEX" },
  { href: "/how-much-i-fucked-up", label: "HOW MUCH I FUCKED UP" },
];
---

<nav class="nav">
  <div class="nav__container">
    <a href="/" class="nav__logo">BTC_THINGS</a>
    
    <input
      type="checkbox"
      id="nav-open"
      class="nav__toggle-input"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    />
    <div class="nav__links" id="nav-links">
      {navItems.map(item => (
        <a 
          href={item.href}
          class:list={['nav__link', { 'nav__link--active': current === item.href }]}
          aria-current={current === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
    
    <!-- Rotulo de checkbox, nao botao: sem JS o menu ainda abre, e sem ele o
         nav mobile ficava inalcancavel nas 8 paginas. -->
    <label for="nav-open" class="nav__mobile-toggle">
      <span aria-hidden="true">☰</span>
      <span class="nav__mobile-toggle-text">Menu</span>
    </label>
  </div>
</nav>

<style>
  .nav {
    border-bottom: var(--border-width) solid var(--border);
    padding: 1rem 0;
    margin-bottom: 2rem;
  }
  
  .nav__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .nav__logo {
    font-size: 1.5rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  
  .nav__links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  
  .nav__link {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }
  
  .nav__link {
    color: var(--fg-secondary);
  }
  
  .nav__link:hover {
    text-decoration: none;
    color: var(--accent-btc);
    border-bottom-color: var(--accent-btc);
  }
  
  /* Active page reads as a terminal prompt, so it stays distinct from hover. */
  .nav__link--active {
    color: var(--accent-btc);
    font-weight: bold;
    border-bottom-color: var(--accent-btc);
  }
  
  .nav__link--active::before {
    content: "> ";
  }
  
  .nav__link--active::after {
    content: " <";
  }
  
  .nav__toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  /* Tratado como controle, nao como glifo decorativo: era o unico caminho
     para o nav no mobile e nao tinha moldura nenhuma. */
  .nav__mobile-toggle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-body);
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    background: var(--bg-surface);
    border: 1px solid var(--fg-muted);
    color: var(--accent-btc);
    cursor: pointer;
    min-height: 44px;
  }
  
  .nav__toggle-input:focus-visible + .nav__links + .nav__mobile-toggle,
  .nav__toggle-input:focus-visible ~ .nav__mobile-toggle {
    outline: var(--border-width) solid var(--border-accent);
    outline-offset: 2px;
  }
  
  @media (max-width: 768px) {
    .nav__links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .nav__toggle-input:checked ~ .nav__links {
      display: flex;
    }
    
    .nav__mobile-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  // O abrir/fechar e CSS puro; o script so mantem aria-expanded em dia.
  const input = document.getElementById('nav-open');

  input?.addEventListener('change', () => {
    input.setAttribute('aria-expanded', String(input.checked));
  });
</script>